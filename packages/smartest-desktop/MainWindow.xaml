<Window x:Class="smartest_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmarTest — Bienvenue"
        Icon="/Assets/SmarTest-AppIcon.png"
        Height="700" Width="1100"
        MinHeight="560" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/AuthStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Glows décoratifs -->
		<Ellipse Width="500" Height="500"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-200,-120,0"
                 Fill="{DynamicResource AccentBrush}" Opacity="0.05"
                 Grid.RowSpan="3"/>
		<Ellipse Width="350" Height="350"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-80,0,0,-120"
                 Fill="{DynamicResource NavyBrush}" Opacity="0.03"
                 Grid.RowSpan="3"/>

		<!-- NAVBAR -->
		<Border Grid.Row="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                Padding="56,0" Height="48">
			<Grid>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
					<TextBlock FontFamily="Georgia" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center">
						Smar<Run Foreground="{DynamicResource AccentBrush}">Test</Run>
					</TextBlock>
				</StackPanel>
				<Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{DynamicResource BgSubBrush}" CornerRadius="20"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="14,4">
					<TextBlock Text="ENSA · GÉNIE INFORMATIQUE · 2025–2026"
                               FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
				</Border>
			</Grid>
		</Border>

		<!-- HERO -->
		<Grid Grid.Row="1">
			<StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">

				<!-- Badge -->
				<Border Background="{DynamicResource AccentLightBgBrush}" CornerRadius="20"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        Padding="18,6" HorizontalAlignment="Center"
                        Margin="0,0,0,24">
					<StackPanel Orientation="Horizontal">
						<Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock Text="PLATEFORME D'ÉVALUATION INTELLIGENTE"
                                   FontSize="10" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
					</StackPanel>
				</Border>

				<!-- Titre -->
				<TextBlock FontFamily="Georgia" FontSize="52" FontWeight="Bold"
						   Foreground="{DynamicResource NavyBrush}" HorizontalAlignment="Center">
					Smar<Run Foreground="{DynamicResource AccentBrush}">Test</Run>
				</TextBlock>

				<!-- Sous-titre -->
				<TextBlock Text="SYSTÈME SÉCURISÉ DE GESTION D'ÉVALUATIONS"
                           FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

				<!-- Ligne accent -->
				<Border Width="44" Height="2" Background="{DynamicResource AccentBrush}"
                        CornerRadius="2" HorizontalAlignment="Center"
                        Margin="0,0,0,22"/>

				<!-- Description -->
				<TextBlock HorizontalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                           MaxWidth="500" TextAlignment="Center"
                           LineHeight="26" Margin="0,0,0,36">
					Créez et supervisez vos évaluations avec une
					<Run Foreground="{DynamicResource NavyBrush}" FontWeight="SemiBold">IA pédagogique</Run>
					— générez rapidement des quiz et examens,
					puis suivez les résultats de vos étudiants.
				</TextBlock>

				<!-- Boutons -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,0,0,44">
					<Button Style="{StaticResource PrimaryBtn}"
                            Command="{Binding GoToLoginCommand}"
                            Width="180" Margin="0,0,12,0"
                            Height="46">
						<TextBlock Text="Se connecter" FontSize="13"/>
					</Button>
					<Button Style="{StaticResource SecondaryBtn}"
                            Command="{Binding GoToRegisterCommand}"
                            Width="230" Height="46">
						<TextBlock Text="Créer un compte professeur" FontSize="13"/>
					</Button>
				</StackPanel>

				<!-- Feature cards -->
				<UniformGrid Columns="3" Width="780">
					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="14"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="20,22" Margin="0,0,8,0">
						<StackPanel>
							<Border Width="42" Height="42" CornerRadius="11"
                                    Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
								<TextBlock Text="🤖" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
							</Border>
							<TextBlock Text="Génération intelligente"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource NavyBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
							<TextBlock Text="Créez rapidement des quiz et examens avec assistance IA directement dans l'application."
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="17"/>
						</StackPanel>
					</Border>

					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="14"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="20,22" Margin="4,0,4,0">
						<StackPanel>
							<Border Width="42" Height="42" CornerRadius="11"
                                    Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
								<TextBlock Text="🔓" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
							</Border>
							<TextBlock Text="Publication et sécurité"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource NavyBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
							<TextBlock Text="Gérez les accès étudiants par email, publiez vos quiz sur le web et conservez un contrôle local des données."
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="17"/>
						</StackPanel>
					</Border>

					<Border Background="{DynamicResource CardBgBrush}" CornerRadius="14"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="20,22" Margin="8,0,0,0">
						<StackPanel>
							<Border Width="42" Height="42" CornerRadius="11"
                                    Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" HorizontalAlignment="Center"
                                    Margin="0,0,0,12">
								<TextBlock Text="⚡" FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
							</Border>
							<TextBlock Text="Suivi et résultats détaillés"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource NavyBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
							<TextBlock Text="Consultez les statistiques par question, identifiez les points à risque et exportez les résultats en CSV/PDF."
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       LineHeight="17"/>
						</StackPanel>
					</Border>
				</UniformGrid>

			</StackPanel>
		</Grid>

		<!-- FOOTER -->
		<Border Grid.Row="2" Background="{DynamicResource FooterBarBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Padding="0,14">
			<TextBlock Text="SmarTest — ENSA Oujda · Génie Informatique · 2025–2026"
                       FontSize="11" Foreground="{DynamicResource FooterBrush}"
                       HorizontalAlignment="Center"/>
		</Border>

	</Grid>
</Window>

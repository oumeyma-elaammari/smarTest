<UserControl x:Class="smartest_desktop.Views.SessionsActivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:smartest_desktop.Helpers"
             FontFamily="Segoe UI"
             Background="{DynamicResource WindowBgBrush}"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:IntLevelToVisibilityConverter x:Key="NiveauVis"/>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <!-- NIVEAU 1 — Examens -->
        <Grid Visibility="{Binding NiveauActuel, Converter={StaticResource NiveauVis}, ConverterParameter=1}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource WindowBgBrush}" Padding="40,36,40,28">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sessions examens" FontSize="22" FontWeight="700"
                                   Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="40,0,40,56" VerticalScrollBarVisibility="Auto"
                          ClipToBounds="True" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Chargement…" Foreground="{DynamicResource GrayTextBrush}" FontSize="14" Margin="0,40,0,0"
                               HorizontalAlignment="Center"
                               Visibility="{Binding ChargementExamens, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Foreground="{DynamicResource GrayTextBrush}" FontSize="13" Margin="0,32,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" Visibility="{Binding AucunExamen, Converter={StaticResource BoolToVis}}">
                        <Run Text="Aucun examen terminé."/>
                        <LineBreak/>
                        <Run Text="Terminez une session depuis « Quiz et examens » (Lancer puis Terminer sur le web)."
                             FontSize="12"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ExamensTermines}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChargementExamens}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AucunExamen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Height="160" Margin="0,0,16,16"
                                        Background="{DynamicResource ContentBgBrush}" CornerRadius="16"
                                        BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.06"
                                                          BlurRadius="12" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <Grid Margin="20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="{DynamicResource SuccessLightBgBrush}" CornerRadius="6" Padding="8,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatutAffiche}" Foreground="{DynamicResource SuccessGreenBrush}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                ToolTip="Retirer de la liste"
                                                Command="{Binding DataContext.SupprimerExamenCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource DangerBrush}" Cursor="Hand" Padding="4"
                                                FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE74D;"/>
                                        <Grid Grid.Row="1" Grid.RowSpan="2" Cursor="Hand">
                                            <Grid.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                    Command="{Binding DataContext.SelectionnerExamenCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            </Grid.InputBindings>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Titre}" FontSize="16"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource ContentTextBrush}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Grid Grid.Row="1">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource GrayTextBrush}">
                                                    <Run Text="{Binding NbParticipants, Mode=OneWay}"/>
                                                    <Run Text=" étudiant(s)"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DateFormatee}" FontSize="12"
                                                           Foreground="{DynamicResource GrayTextBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- NIVEAU 2 — Étudiants -->
        <Grid Visibility="{Binding NiveauActuel, Converter={StaticResource NiveauVis}, ConverterParameter=2}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ContentBgBrush}" Padding="20,10"
                    BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="←" Command="{Binding RetourExamensCommand}"
                            ToolTip="Retour"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="18" Cursor="Hand" Margin="0,0,20,0" Padding="4,0"/>
                    <TextBlock Text="{Binding ExamenSelectionne.Titre}" FontSize="20"
                               FontWeight="Bold" Foreground="{DynamicResource ContentTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="20,12,20,56" VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                <StackPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,12" Visibility="{Binding AfficherMessage, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Chargement des participants…" Foreground="{DynamicResource GrayTextBrush}" FontSize="13"
                               Margin="0,24,0,0" HorizontalAlignment="Center"
                               Visibility="{Binding ChargementEtudiants, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Aucun participant enregistré pour cet examen."
                               Foreground="{DynamicResource GrayTextBrush}" FontSize="13" Margin="0,24,0,0"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding AucunEtudiant, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding EtudiantsDuExamen}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChargementEtudiants}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AucunEtudiant}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Background="{DynamicResource ContentBgBrush}" CornerRadius="12"
                                        BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="1" Cursor="Hand">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.04"
                                                          BlurRadius="8" ShadowDepth="1"/>
                                    </Border.Effect>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                            Command="{Binding DataContext.VoirCorrectionCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid Margin="20,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40"
                                                Background="{DynamicResource AvatarBgBrush}" CornerRadius="20">
                                            <TextBlock Text="{Binding Initiale}" Foreground="{DynamicResource AvatarFgBrush}"
                                                       FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <TextBlock Text="{Binding Nom}" FontSize="15"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource ContentTextBrush}"/>
                                            <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{DynamicResource GrayTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,16,0" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding LibelleNote}" FontSize="11" Foreground="{DynamicResource GrayTextBrush}"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding NoteAfficheeText}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstNoteReussie}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="3" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WarnLightBgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ValideeParProf}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="En attente"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ValideeParProf}" Value="True">
                                                                <Setter Property="Text" Value="Validé ✓"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- NIVEAU 3 — Correction -->
        <Grid Visibility="{Binding NiveauActuel, Converter={StaticResource NiveauVis}, ConverterParameter=3}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ContentBgBrush}" Padding="20,10"
                    BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="←" Command="{Binding RetourEtudiantsCommand}"
                                ToolTip="Retour"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="18" Cursor="Hand" Margin="0,0,20,0" Padding="4,0"/>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ContentTextBrush}" VerticalAlignment="Center">
                            <Run Text="Correction — "/>
                            <Run Text="{Binding EtudiantSelectionne.Nom, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource GrayTextBrush}" FontSize="14">
                            <Run Text="Total : "/>
                            <Run Text="{Binding NoteTotale, Mode=OneWay}" FontWeight="Bold">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstNoteTotaleReussie}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessGreenBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                            <Run Text=" pts"/>
                        </TextBlock>
                        <Button Content="Valider la correction"
                                Command="{Binding ValiderCorrectionCommand}"
                                Background="{DynamicResource PrimaryActionBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                Foreground="{DynamicResource PrimaryActionFgBrush}"
                                BorderThickness="1"
                                Padding="18,11" FontSize="12" FontWeight="600" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ButtonBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="9"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
                                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="20,12,20,16" VerticalScrollBarVisibility="Auto" ClipToBounds="True">
                <StackPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource GrayTextBrush}" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,12" Visibility="{Binding AfficherMessage, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding LignesCorrection}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Background="{DynamicResource ContentBgBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="1" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Enonce}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource ContentTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Border Grid.Row="1" Background="{DynamicResource AnswerBgBrush}" CornerRadius="6"
                                                Padding="10" Margin="0,0,0,8">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource AnswerFgBrush}" TextWrapping="Wrap">
                                                <Run Text="Réponse : " Foreground="{DynamicResource GrayTextBrush}"/>
                                                <Run Text="{Binding ReponseEtudiantFormatee, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource PurpleLightBgBrush}" CornerRadius="6"
                                                    Padding="8,4" HorizontalAlignment="Left"
                                                    Visibility="{Binding CorrigeParIa, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Corrigé par IA" Foreground="{DynamicResource SecondaryAccentBrush}"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="Note : " VerticalAlignment="Center"
                                                           Foreground="{DynamicResource GrayTextBrush}" FontSize="14" Margin="0,0,8,0"/>
                                                <Border BorderBrush="{DynamicResource ContentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2">
                                                    <TextBox Text="{Binding NoteFinale, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="60" FontSize="16" FontWeight="Bold"
                                                             Foreground="{DynamicResource SecondaryAccentBrush}" BorderThickness="0"
                                                             Background="Transparent"
                                                             TextAlignment="Center" VerticalContentAlignment="Center"/>
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource GrayTextBrush}"
                                                           FontSize="14" Margin="8,0,0,0">
                                                    <Run Text="/ "/>
                                                    <Run Text="{Binding NoteMax, Mode=OneWay, StringFormat={}{0:0.##}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>

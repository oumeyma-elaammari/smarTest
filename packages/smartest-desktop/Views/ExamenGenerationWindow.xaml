<Window x:Class="smartest_desktop.Views.ExamenGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:smartest_desktop.ViewModels"
        Title="SmarTest — Générer un examen"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
				<ResourceDictionary Source="/Views/Styles/GenerationSharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="CounterBtn" TargetType="Border">
				<Setter Property="Width" Value="30"/>
				<Setter Property="Height" Value="30"/>
				<Setter Property="CornerRadius" Value="8"/>
				<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
					</Trigger>
				</Style.Triggers>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="{DynamicResource WindowBgBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- HEADER (aligné Générer un quiz) -->
		<Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" Padding="14,10" Margin="0,0,0,0">
			<Border.Effect>
				<DropShadowEffect BlurRadius="24" ShadowDepth="1" Direction="270"
                                  Opacity="0.04" Color="#0f1e3d"/>
			</Border.Effect>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                        Background="{DynamicResource AccentLightBgBrush}" Cursor="Hand" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
					<Border.InputBindings>
						<MouseBinding MouseAction="LeftClick" Command="{Binding AnnulerCommand}"/>
					</Border.InputBindings>
					<TextBlock Text="&#xE72B;" FontSize="15" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource NavyBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="Nouvel examen" FontSize="20" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- CONTENU -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="380"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ══ COLONNE GAUCHE — Configuration ══ -->
			<Border Grid.Column="0" Background="{DynamicResource WindowBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
				<ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="24,26,24,28">

						<TextBlock Text="Paramètres"
                                   FontSize="18" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,0,0,24"/>

						<!-- Titre -->
						<TextBlock Text="TITRE DE L'EXAMEN" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,8"/>
						<Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" Padding="14,12" Margin="0,0,0,24">
							<TextBox Text="{Binding TitreExamen, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="12" Foreground="{DynamicResource NavyBrush}"
                                     VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
						</Border>

						<!-- Durée -->
						<TextBlock Text="DURÉE (MINUTES)" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,8"/>
						<ComboBox Style="{StaticResource StyledCombo}"
                                  ItemsSource="{Binding DureesDisponibles}"
                                  SelectedItem="{Binding Duree}"
                                  Margin="0,0,0,24"/>

						<!-- Difficulté (même gabarit que quiz) -->
						<TextBlock Text="NIVEAU DE DIFFICULTÉ" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,10"/>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,28">

							<Border>
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding SetDifficulteCommand}"
                                                  CommandParameter="Facile"/>
								</Border.InputBindings>
								<Border.Style>
									<Style TargetType="Border" BasedOn="{StaticResource GenDiffChip}">
										<Style.Triggers>
											<DataTrigger Binding="{Binding Difficulte}" Value="Facile">
												<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<StackPanel HorizontalAlignment="Center">
									<Ellipse Width="12" Height="12" Fill="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
									<TextBlock Text="Facile" FontSize="11" FontWeight="600"
                                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
								</StackPanel>
							</Border>

							<Border>
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding SetDifficulteCommand}"
                                                  CommandParameter="Moyen"/>
								</Border.InputBindings>
								<Border.Style>
									<Style TargetType="Border" BasedOn="{StaticResource GenDiffChip}">
										<Style.Triggers>
											<DataTrigger Binding="{Binding Difficulte}" Value="Moyen">
												<Setter Property="Background" Value="{DynamicResource WarnLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<StackPanel HorizontalAlignment="Center">
									<Ellipse Width="12" Height="12" Fill="{DynamicResource WarnBrush}" HorizontalAlignment="Center"/>
									<TextBlock Text="Moyen" FontSize="11" FontWeight="600"
                                               Foreground="{DynamicResource WarnBrush}" HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
								</StackPanel>
							</Border>

							<Border>
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding SetDifficulteCommand}"
                                                  CommandParameter="Difficile"/>
								</Border.InputBindings>
								<Border.Style>
									<Style TargetType="Border" BasedOn="{StaticResource GenDiffChip}">
										<Setter Property="Margin" Value="0"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding Difficulte}" Value="Difficile">
												<Setter Property="Background" Value="{DynamicResource DangerZoneBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource DangerZoneBorderBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<StackPanel HorizontalAlignment="Center">
									<Ellipse Width="12" Height="12" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
									<TextBlock Text="Difficile" FontSize="11" FontWeight="600"
                                               Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"
                                               Margin="0,4,0,0"/>
								</StackPanel>
							</Border>
						</StackPanel>

						<!-- Types de questions -->
						<TextBlock Text="TYPES DE QUESTIONS" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,12"/>

						<!-- QCM -->
						<Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" Padding="16,12" Margin="0,0,0,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Choix unique (QCU)"
                                           FontSize="13" FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                           VerticalAlignment="Center"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding DecrQCMCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="−" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<TextBox Text="{Binding NbQCM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="44" Height="30" Margin="6,0"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="15" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             TextAlignment="Center" Padding="0"/>
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding IncrQCMCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="+" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
							</Grid>
						</Border>

						<!-- VRAI / FAUX -->
						<Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" Padding="16,12" Margin="0,0,0,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Vrai / Faux (VF)"
                                           FontSize="13" FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                           VerticalAlignment="Center"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding DecrVFCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="−" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<TextBox Text="{Binding NbVF, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="44" Height="30" Margin="6,0"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="15" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             TextAlignment="Center" Padding="0"/>
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding IncrVFCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="+" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
							</Grid>
						</Border>

						<!-- CHECKBOX -->
						<Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" Padding="16,12" Margin="0,0,0,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Cases à cocher"
                                           FontSize="13" FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                           VerticalAlignment="Center"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding DecrCheckboxCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="−" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<TextBox Text="{Binding NbCheckbox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="44" Height="30" Margin="6,0"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="15" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             TextAlignment="Center" Padding="0"/>
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding IncrCheckboxCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="+" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
							</Grid>
						</Border>

						<!-- RÉDACTION -->
						<Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" Padding="16,12" Margin="0,0,0,16">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Rédaction"
                                           FontSize="13" FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                           VerticalAlignment="Center"/>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding DecrRedactionCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="−" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<TextBox Text="{Binding NbRedaction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="44" Height="30" Margin="6,0"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="15" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                             TextAlignment="Center" Padding="0"/>
									<Border Style="{StaticResource CounterBtn}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding IncrRedactionCommand}"/>
										</Border.InputBindings>
										<TextBlock Text="+" FontSize="16" FontWeight="700" Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
							</Grid>
						</Border>

						<!-- Total -->
						<Border Background="{DynamicResource AccentLightBgBrush}" CornerRadius="12"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,28">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBlock Text="Total de questions"
                                           FontSize="13" FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                           VerticalAlignment="Center"/>
								<TextBlock Grid.Column="1"
                                           Text="{Binding TotalQuestions}"
                                           FontSize="24" FontWeight="700" Foreground="{DynamicResource AccentBrush}"/>
							</Grid>
						</Border>

						<!-- Statut / erreur (même schéma que générer quiz) -->
						<Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                                Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
							<TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
						</Border>

						<Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                                Background="{DynamicResource AlertErrorBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
							<TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                       Foreground="{DynamicResource AlertErrorFgBrush}" TextWrapping="Wrap"/>
						</Border>

						<!-- Bouton Générer -->
						<Border CornerRadius="12" Padding="0,16" Cursor="Hand"
                                Visibility="{Binding IsNotGenerating, Converter={StaticResource BoolToVis}}">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
									<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
									<Setter Property="BorderThickness" Value="1"/>
									<Setter Property="Cursor" Value="Hand"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
											<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
										</Trigger>
										<DataTrigger Binding="{Binding HasCours}" Value="False">
											<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
											<Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
											<Setter Property="Cursor" Value="Arrow"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding GenererCommand}"/>
							</Border.InputBindings>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
								<TextBlock Text="Générer l'examen"
                                           FontSize="14" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center"/>
							</StackPanel>
						</Border>

						<!-- Bouton Annuler génération -->
						<Border CornerRadius="12" Padding="0,16" Cursor="Hand"
                                Background="{DynamicResource DangerZoneBgBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding AnnulerGenerationCommand}"/>
							</Border.InputBindings>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
								<TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBlock Text="Annuler la génération"
                                           FontSize="13" FontWeight="600" Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center"/>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- ══ COLONNE DROITE — Import + cours ══ -->
			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Border Grid.Row="0" Padding="28,22,28,18" Background="{DynamicResource WindowBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="Cours importés" FontSize="17" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
							<TextBlock Text="Import multiple possible · texte modifiable ci-dessous."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
						</StackPanel>
						<Border Grid.Column="1" CornerRadius="10" Cursor="Hand" Padding="16,10" VerticalAlignment="Center">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding ImporterFichierCommand}"/>
							</Border.InputBindings>
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
									<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
									<Setter Property="BorderThickness" Value="1"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
											<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
										</Trigger>
										<DataTrigger Binding="{Binding IsImporting}" Value="True">
											<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
											<Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<StackPanel Orientation="Horizontal">
								<TextBlock FontSize="12" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Text" Value="Importer des cours"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsImporting}" Value="True">
													<Setter Property="Text" Value="Import en cours..."/>
												</DataTrigger>
												<DataTrigger Binding="{Binding HasCours}" Value="True">
													<Setter Property="Text" Value="Ajouter des cours"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</StackPanel>
						</Border>
					</Grid>
				</Border>

				<Grid Grid.Row="1" Background="{DynamicResource WindowBgBrush}">

					<!-- État vide -->
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasCours}" Value="False">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>
						<Border Width="320" Height="220" CornerRadius="16"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2"
                                Background="{DynamicResource CardBgBrush}" Cursor="Hand">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding ImporterFichierCommand}"/>
							</Border.InputBindings>
							<Border.Style>
								<Style TargetType="Border">
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
											<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
								<TextBlock Text="Importer des cours"
                                           FontSize="14" FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                           HorizontalAlignment="Center"/>
								<TextBlock Text="PDF · DOCX · TXT"
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
							</StackPanel>
						</Border>
					</StackPanel>

					<!-- Cours importé -->
					<Grid>
						<Grid.Style>
							<Style TargetType="Grid">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasCours}" Value="True">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<Border Grid.Row="0" Margin="20,16,20,0" CornerRadius="12"
                                Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid Grid.Row="0">
									<ItemsControl ItemsSource="{Binding FichiersImportes}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Margin="0,0,8,8" Padding="10,6" CornerRadius="8"
                                                        Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
													<StackPanel Orientation="Horizontal">
														<TextBlock Text="{Binding Titre}" FontWeight="600" FontSize="12"
                                                                   Foreground="{DynamicResource NavyBrush}"/>
														<Border CornerRadius="4" Padding="4,1" Margin="8,0,0,0"
                                                                Background="{DynamicResource AccentLightBgBrush}" VerticalAlignment="Center">
															<TextBlock Text="{Binding TypeExtension}" FontSize="10"
                                                                       FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
														</Border>
														<Border Width="20" Height="20" CornerRadius="6"
                                                                Background="{DynamicResource AlertErrorBgBrush}" Cursor="Hand"
                                                                Margin="8,0,0,0" VerticalAlignment="Center">
															<Border.InputBindings>
																<MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.SupprimerFichierImporteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              CommandParameter="{Binding}"/>
															</Border.InputBindings>
															<TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="9" Foreground="{DynamicResource DangerBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
														</Border>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Grid>
								<TextBlock Grid.Row="1" Text="{Binding NombreCaracteres}" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,8,0,0"/>
							</Grid>
						</Border>

						<Border Grid.Row="1" Margin="20,12,20,20" CornerRadius="12"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>
								<Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                        Background="{DynamicResource InputBgBrush}">
									<TextBlock Text="Texte extrait (modifiable)"
                                               FontSize="11" FontWeight="600" Foreground="{DynamicResource SubTextBrush}"/>
								</Border>
								<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="14,12" MinHeight="240">
									<TextBox Text="{Binding ContenuCours, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Foreground="{DynamicResource AnswerFgBrush}"
                                             BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             CaretBrush="{DynamicResource AccentBrush}"/>
								</ScrollViewer>
							</Grid>
						</Border>
					</Grid>

				</Grid>
			</Grid>

		</Grid>

		<Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="18,14">
			<TextBlock Text="SmarTest — ENSA Oujda · Génie Informatique · 2025–2026"
                       FontSize="11" Foreground="{DynamicResource FooterBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Border>

	</Grid>
</Window>


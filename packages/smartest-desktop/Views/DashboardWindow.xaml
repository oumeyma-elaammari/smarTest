<Window x:Class="smartest_desktop.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:smartest_desktop.ViewModels"
        Title="SmarTest"
        Icon="/Assets/SmarTest-AppIcon.png"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="860"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:DashboardViewModel />
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBgBrush}">
            <StackPanel Margin="40,36,40,40">

                <!-- Header -->
                <StackPanel Margin="0,0,0,32">
                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6">
                        <Run Text="BONJOUR, "/>
                        <Run Text="{Binding Nom}" FontWeight="600"/>
                    </TextBlock>
                    <TextBlock Text="Home" FontSize="26" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
                </StackPanel>

                <!-- Stats Cards -->
                <Grid Margin="0,0,0,36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashCard}">
                        <StackPanel>
                            <Border Width="36" Height="2" Background="{DynamicResource NavyBrush}"
                                    CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding TotalExamensACorriger, FallbackValue=0}"
                                       FontSize="32" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
                            <TextBlock Text="Examens à corriger" FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashCard}">
                        <StackPanel>
                            <Border Width="36" Height="2" Background="{DynamicResource NavyBrush}"
                                    CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding TotalExamens, FallbackValue=0}"
                                       FontSize="32" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
                            <TextBlock Text="Examens créés" FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource DashCard}">
                        <StackPanel>
                            <Border Width="36" Height="2" Background="{DynamicResource NavyBrush}"
                                    CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Text="{Binding TotalQuiz, FallbackValue=0}"
                                       FontSize="32" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
                            <TextBlock Text="Quiz créés" FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Activités récentes -->
                <Border Style="{StaticResource DashCard}" Padding="24,20" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Activités récentes" FontSize="15"
                                   FontWeight="600" Foreground="{DynamicResource NavyBrush}" Margin="0,0,6,4"/>

                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,12"/>

                        <ItemsControl ItemsSource="{Binding ActivitesRecentes}"
                                      Visibility="{Binding HasRecentActivities, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,12" Margin="0,0,0,10"
                                            Background="{DynamicResource ActivityItemBgBrush}" CornerRadius="10"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    CornerRadius="10" Background="{DynamicResource AccentLightBgBrush}"
                                                    Margin="0,0,14,0" VerticalAlignment="Top">
                                                <TextBlock Text="&#xE9D5;" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Titre}" FontSize="14"
                                                           FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SousTitre}" FontSize="12"
                                                           Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,4"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DateFormatee}" FontSize="11"
                                                           Foreground="{DynamicResource FooterBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center" Margin="0,12"
                                    Visibility="{Binding HasNoRecentActivities, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Aucune activité pour le moment"
                                       FontSize="13" FontWeight="600"
                                       Foreground="{DynamicResource NavyBrush}" HorizontalAlignment="Center"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Créez un quiz ou un examen pour le voir ici"
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

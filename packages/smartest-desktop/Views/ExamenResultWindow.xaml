<Window x:Class="smartest_desktop.Views.ExamenResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:smartest_desktop="clr-namespace:smartest_desktop.Helpers"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="{Binding TitreFenetre}"
        Height="780" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<!-- Convertisseurs -->
			<BooleanToVisibilityConverter x:Key="BoolToVis"/>
			<!-- Inverse: True → Collapsed, False → Visible -->
			<smartest_desktop:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse"/>

			<Style x:Key="QRCard" TargetType="Border">
				<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
				<Setter Property="CornerRadius" Value="12"/>
				<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
			</Style>

			<Style x:Key="QRValidateBorder" TargetType="Border">
				<Setter Property="CornerRadius" Value="9"/>
				<Setter Property="Padding" Value="18,11"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Background" Value="{DynamicResource PrimaryActionBgBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
						<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
					</Trigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="QRSecondaryBorder" TargetType="Border">
				<Setter Property="CornerRadius" Value="9"/>
				<Setter Property="Padding" Value="14,9"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Background" Value="{DynamicResource BgBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
					</Trigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="QREditField" TargetType="TextBox">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Padding" Value="0"/>
				<Setter Property="FontSize" Value="12"/>
				<Setter Property="Foreground" Value="{DynamicResource NavyBrush}"/>
				<Setter Property="TextWrapping" Value="Wrap"/>
				<Setter Property="AcceptsReturn" Value="True"/>
				<Setter Property="CaretBrush" Value="{DynamicResource NavyBrush}"/>
			</Style>

			<Style x:Key="OptionRow" TargetType="Border">
				<Setter Property="CornerRadius" Value="8"/>
				<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Padding" Value="12,10"/>
				<Setter Property="Margin" Value="0,0,0,8"/>
				<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
			</Style>

			<Style x:Key="ActionBtn" TargetType="Border">
				<Setter Property="CornerRadius" Value="8"/>
				<Setter Property="Padding" Value="16,10"/>
				<Setter Property="Cursor" Value="Hand"/>
			</Style>

			<Style x:Key="ResultComboBox" TargetType="ComboBox">
				<Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
				<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="MinHeight" Value="32"/>
				<Setter Property="Padding" Value="8,4"/>
				<Setter Property="ItemContainerStyle">
					<Setter.Value>
						<Style TargetType="ComboBoxItem">
							<Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
							<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
							<Setter Property="Padding" Value="10,7"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ComboBoxItem">
										<Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
											<ContentPresenter/>
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsHighlighted" Value="True">
												<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBgBrush}"/>
											</Trigger>
											<Trigger Property="IsSelected" Value="True">
												<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
												<Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</Setter.Value>
				</Setter>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="ComboBox">
							<Grid>
								<ToggleButton Focusable="False"
											  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
											  ClickMode="Press"
											  Background="Transparent"
											  BorderThickness="0">
									<ToggleButton.Template>
										<ControlTemplate TargetType="ToggleButton">
											<Border x:Name="ComboBorder"
													Background="{DynamicResource InputBgBrush}"
													BorderBrush="{DynamicResource InputBorderBrush}"
													BorderThickness="1"
													CornerRadius="8"
													Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Grid.Column="0"
															   Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
															   Foreground="{DynamicResource TextBrush}"
															   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
															   FontWeight="SemiBold"
															   Margin="4,0,8,0"
															   VerticalAlignment="Center"
															   TextTrimming="CharacterEllipsis"/>
													<TextBlock Grid.Column="1" Text="⌄" FontSize="12"
															   Foreground="{DynamicResource SubTextBrush}"
															   VerticalAlignment="Center"/>
												</Grid>
											</Border>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</ToggleButton.Template>
								</ToggleButton>
								<Popup Placement="Bottom"
									   IsOpen="{TemplateBinding IsDropDownOpen}"
									   AllowsTransparency="True"
									   Focusable="False"
									   PopupAnimation="Slide">
									<Border Background="{DynamicResource InputBgBrush}"
											BorderBrush="{DynamicResource InputBorderBrush}"
											BorderThickness="1"
											CornerRadius="8"
											Margin="0,4,0,0"
											MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
										<ScrollViewer MaxHeight="220">
											<ItemsPresenter/>
										</ScrollViewer>
									</Border>
								</Popup>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="ResultDatePickerTextBox" TargetType="{x:Type primitives:DatePickerTextBox}">
				<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
							<Border Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Padding="8,4">
								<ScrollViewer x:Name="PART_ContentHost"/>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style TargetType="{x:Type primitives:DatePickerTextBox}" BasedOn="{StaticResource ResultDatePickerTextBox}"/>

			<Style x:Key="ResultDatePicker" TargetType="DatePicker">
				<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="BorderBrush" Value="Transparent"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="MinHeight" Value="32"/>
				<Setter Property="CalendarStyle">
					<Setter.Value>
						<Style TargetType="Calendar">
							<Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
							<Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
						</Style>
					</Setter.Value>
				</Setter>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="DatePicker">
							<Grid x:Name="PART_Root">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<primitives:DatePickerTextBox x:Name="PART_TextBox"
															  Grid.Column="0"
															  Background="{DynamicResource InputBgBrush}"
															  BorderBrush="{DynamicResource InputBorderBrush}"
															  Foreground="{DynamicResource TextBrush}"
															  FontWeight="SemiBold"
															  VerticalAlignment="Center"/>

								<Button x:Name="PART_Button"
										Grid.Column="1"
										Width="32"
										Margin="6,0,0,0"
										Focusable="False"
										BorderThickness="0"
										Background="{DynamicResource AccentLightBgBrush}"
										Foreground="{DynamicResource AccentTextBrush}">
									<Button.Template>
										<ControlTemplate TargetType="Button">
											<Border x:Name="CalendarButtonBorder"
													Background="{TemplateBinding Background}"
													CornerRadius="8"
													Padding="6,4">
												<TextBlock Text="&#xE787;"
														   FontFamily="Segoe MDL2 Assets"
														   FontSize="12"
														   Foreground="{TemplateBinding Foreground}"
														   HorizontalAlignment="Center"
														   VerticalAlignment="Center"/>
											</Border>
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="CalendarButtonBorder" Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Button.Template>
								</Button>

								<Popup x:Name="PART_Popup"
									   Placement="Bottom"
									   AllowsTransparency="True"
									   Focusable="False"
									   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
									   PopupAnimation="Slide">
									<Border Background="{DynamicResource InputBgBrush}"
											BorderBrush="{DynamicResource InputBorderBrush}"
											BorderThickness="1"
											CornerRadius="10"
											Margin="0,4,0,0">
										<Calendar x:Name="PART_Calendar"
												  Style="{TemplateBinding CalendarStyle}"
												  SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}}"
												  DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"
												  FirstDayOfWeek="{Binding FirstDayOfWeek, RelativeSource={RelativeSource TemplatedParent}}"/>
									</Border>
								</Popup>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ══ HEADER ══ -->
		<Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="28,16">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                        Background="{DynamicResource AccentLightBgBrush}" Cursor="Hand" Margin="0,0,20,0">
					<Border.InputBindings>
						<MouseBinding MouseAction="LeftClick" Command="{Binding RetourCommand}"/>
					</Border.InputBindings>
					<TextBlock Text="&#xE72B;" FontSize="14" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource NavyBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Margin="0,0,0,3">
						<Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox Text="{Binding TitreExamen, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="320"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="16"
                                 FontWeight="700"
                                 Foreground="{DynamicResource NavyBrush}"
                                 VerticalContentAlignment="Center"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding SousTitreCompteur}"/>
						<TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
						<TextBlock Text="{Binding SousTitreEtape}"
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
					</StackPanel>
				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<Border Margin="0,0,10,0">
						<Border.Style>
							<Style TargetType="Border" BasedOn="{StaticResource QRSecondaryBorder}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsEditionExistant}" Value="True">
										<Setter Property="Visibility" Value="Collapsed"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<Border.InputBindings>
							<MouseBinding MouseAction="LeftClick" Command="{Binding RegenerarCommand}"/>
						</Border.InputBindings>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
							<TextBlock Text="Regénérer" FontSize="12" FontWeight="500" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource QRValidateBorder}">
						<Border.InputBindings>
							<MouseBinding MouseAction="LeftClick" Command="{Binding ValiderExamenCommand}"/>
						</Border.InputBindings>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource PrimaryActionFgBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding LibelleBoutonValider}" FontSize="12" FontWeight="700" Foreground="{DynamicResource PrimaryActionFgBrush}"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENU ══ -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="380"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ══ LISTE DES QUESTIONS ══ -->
			<Border Grid.Column="0" Background="{DynamicResource WindowBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Border Grid.Row="0" Padding="20,18,20,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
						<StackPanel>
							<TextBlock Text="Questions de l'examen" FontSize="14" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
							<TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Text" Value="{Binding NombreQuestions, StringFormat='{}{0} questions · Modifiables directement'}"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding QuestionsVerrouilleesParPublication}" Value="True">
												<Setter Property="Text" Value="{Binding NombreQuestions, StringFormat='{}{0} questions · Lecture seule (examen publié)'}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"
									   Text="{Binding ResumeBareme}"/>
							<TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
									   Text="{Binding ResumeTempsIndicatifs}"/>
							<Button Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,9" Cursor="Hand"
                                    Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Command="{Binding VoirListeEtudiantsCommand}"
                                    FocusVisualStyle="{x:Null}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBlock Text="Publication et créneau" FontSize="12" FontWeight="600" Foreground="{DynamicResource InputFocusBorderBrush}"
                                               VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
							<TextBlock Text="Ajouter une question" FontSize="10" FontWeight="700"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,8"/>
							<StackPanel Orientation="Horizontal">
								<Button Margin="0,0,6,0" Padding="10,8" Cursor="Hand"
                                        Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Command="{Binding AjouterQuestionCommand}" CommandParameter="QCM"
                                        FocusVisualStyle="{x:Null}">
									<Button.Style>
										<Style TargetType="Button">
											<Setter Property="IsEnabled" Value="True"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding QuestionsVerrouilleesParPublication}" Value="True">
													<Setter Property="IsEnabled" Value="False"/>
													<Setter Property="Opacity" Value="0.5"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
									<TextBlock Text="QCM" FontSize="11" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"/>
								</Button>
								<Button Margin="0,0,6,0" Padding="10,8" Cursor="Hand"
                                        Background="{DynamicResource PurpleLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Command="{Binding AjouterQuestionCommand}" CommandParameter="CHECKBOX"
                                        FocusVisualStyle="{x:Null}">
									<Button.Style>
										<Style TargetType="Button">
											<Setter Property="IsEnabled" Value="True"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding QuestionsVerrouilleesParPublication}" Value="True">
													<Setter Property="IsEnabled" Value="False"/>
													<Setter Property="Opacity" Value="0.5"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
									<TextBlock Text="Cases à cocher" FontSize="11" FontWeight="700" Foreground="{DynamicResource SecondaryAccentBrush}"/>
								</Button>
								<Button Margin="0,0,6,0" Padding="10,8" Cursor="Hand"
                                        Background="{DynamicResource SuccessLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Command="{Binding AjouterQuestionCommand}" CommandParameter="VF"
                                        FocusVisualStyle="{x:Null}">
									<TextBlock Text="Vrai / Faux" FontSize="11" FontWeight="700" Foreground="{DynamicResource SuccessBrush}"/>
								</Button>
								<Button Padding="10,8" Cursor="Hand"
                                        Background="{DynamicResource WarnLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Command="{Binding AjouterQuestionCommand}" CommandParameter="REDACTION"
                                        FocusVisualStyle="{x:Null}">
									<Button.Style>
										<Style TargetType="Button">
											<Setter Property="IsEnabled" Value="True"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding QuestionsVerrouilleesParPublication}" Value="True">
													<Setter Property="IsEnabled" Value="False"/>
													<Setter Property="Opacity" Value="0.5"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Button.Style>
									<TextBlock Text="Rédaction" FontSize="11" FontWeight="700" Foreground="{DynamicResource WarnBrush}"/>
								</Button>
							</StackPanel>
						</StackPanel>
					</Border>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding Questions}" Margin="12,12,12,12">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Margin="0,0,0,6" CornerRadius="10"
                                            Padding="14,12" Cursor="Hand" BorderThickness="1.5">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectionnerCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsSelected}" Value="True">
														<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
														<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
													</DataTrigger>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<Grid>
											<Grid.RowDefinitions>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="Auto"/>
												<RowDefinition Height="Auto"/>
											</Grid.RowDefinitions>

											<!-- Ligne 1 : numéro + badge type + icône image -->
											<Grid Grid.Row="0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="{Binding Numero}"
                                                               FontSize="12" FontWeight="700"
                                                               Foreground="{DynamicResource SubTextBrush}"
                                                               Margin="0,0,8,0" VerticalAlignment="Center"/>
													<Border CornerRadius="4" Padding="6,2">
														<Border.Style>
															<Style TargetType="Border">
																<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																<Setter Property="BorderThickness" Value="1"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Type}" Value="CHECKBOX">
																		<Setter Property="Background" Value="{DynamicResource PurpleLightBgBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Type}" Value="VF">
																		<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Type}" Value="REDACTION">
																		<Setter Property="Background" Value="{DynamicResource WarnLightBgBrush}"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</Border.Style>
														<TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="700">
															<TextBlock.Style>
																<Style TargetType="TextBlock">
																	<Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding Type}" Value="CHECKBOX">
																			<Setter Property="Foreground" Value="{DynamicResource SecondaryAccentBrush}"/>
																		</DataTrigger>
																		<DataTrigger Binding="{Binding Type}" Value="VF">
																			<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
																		</DataTrigger>
																		<DataTrigger Binding="{Binding Type}" Value="REDACTION">
																			<Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</TextBlock.Style>
														</TextBlock>
													</Border>
												</StackPanel>

												<!-- Corbeille (comme liste quiz) -->
												<Border Grid.Column="1"
                                                        Width="26" Height="26" CornerRadius="7"
                                                        Cursor="Hand" ToolTip="Supprimer cette question"
                                                        VerticalAlignment="Center">
													<Border.InputBindings>
														<MouseBinding MouseAction="LeftClick"
                                                                      Command="{Binding DataContext.SupprimerCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                      CommandParameter="{Binding}"/>
													</Border.InputBindings>
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="Transparent"/>
															<Style.Triggers>
																<Trigger Property="IsMouseOver" Value="True">
																	<Setter Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
																</Trigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</Grid>

											<!-- Ligne 2 : énoncé tronqué -->
											<TextBlock Grid.Row="1"
                                                       Text="{Binding Enonce}"
                                                       FontSize="12" Foreground="{DynamicResource NavyBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="42"
                                                       Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis"/>

											<!-- Ligne 3 : image / durée / barème -->
											<Grid Grid.Row="2" Margin="0,4,0,0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<TextBlock Grid.Column="0"
                                                           Text="{Binding ImageNom}"
                                                           FontSize="10" Foreground="{DynamicResource SuccessBrush}"
                                                           FontStyle="Italic"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasImage,
                                                                        Converter={StaticResource BoolToVis}}"/>
												<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
													<TextBlock Text="{Binding DureeSecondesIndicative, StringFormat={}{0} s}"
                                                               FontSize="10" Foreground="{DynamicResource LabelBrush}" VerticalAlignment="Center"/>
													<TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="2,0,2,0"/>
													<TextBlock Text="{Binding BaremePoints, StringFormat='{}{0:0.##} pt'}"
                                                               FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                                               FontWeight="600" VerticalAlignment="Center"/>
												</StackPanel>
											</Grid>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- ══ DÉTAIL / PUBLICATION ══ -->
			<Grid Grid.Column="1" Background="{DynamicResource WindowBgBrush}">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding AfficherEtatSansQuestion, Converter={StaticResource BoolToVis}}">
					<TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{DynamicResource CardBorderBrush}"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="Sélectionnez une question"
                               FontSize="16" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
					<TextBlock Text="ou ouvrez « Publication et créneau » dans la colonne de gauche"
                               FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="340" TextWrapping="Wrap"/>
				</StackPanel>

				<ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding AfficherListeEtudiantsDroite, Converter={StaticResource BoolToVis}}">
					<StackPanel Margin="12,12,12,16">
						<Border Padding="14,12" CornerRadius="10" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
							<StackPanel>
								<TextBlock Text="Publication web" FontSize="13" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
								<TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"
                                           Text="Étudiants autorisés : import CSV / Excel, ajout d'une adresse, sélection multiple pour retirer des lignes. Enregistré avec l'examen à la validation."/>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
									<Border CornerRadius="8" Padding="12,8" Margin="0,0,8,0" Cursor="Hand">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding ImporterEmailsWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
												<Setter Property="BorderThickness" Value="1"/>
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
														<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="Importer fichier" FontSize="11" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"/>
									</Border>
									<Border CornerRadius="8" Padding="12,8" Cursor="Hand"
                                            Background="{DynamicResource DangerZoneBgBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1" ToolTip="Effacer la liste">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding EffacerEmailsWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource DangerBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
								<TextBlock Text="{Binding LibelleEmailsPublicationWeb}" FontSize="10" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,10"/>
								<TextBlock Text="Ajouter un email" FontSize="10" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,4"/>
								<Grid Margin="0,0,0,12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="8"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Border Grid.Column="0" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBgBrush}" Padding="8,4">
										<TextBox Text="{Binding NouvelEmailWeb, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Foreground="{DynamicResource NavyBrush}" BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
									</Border>
									<Border Grid.Column="2" CornerRadius="8" Padding="12,8" Cursor="Hand" VerticalAlignment="Center">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding AjouterEmailUnitaireWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
												<Setter Property="BorderThickness" Value="1"/>
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
														<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="Ajouter" FontSize="11" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"/>
									</Border>
								</Grid>
								<Grid Margin="0,0,0,6">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Liste des emails" FontSize="10" FontWeight="700" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
									<Border Grid.Column="1" Width="28" Height="28" CornerRadius="7" Cursor="Hand"
                                            Background="{DynamicResource DangerZoneBgBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1"
                                            ToolTip="Supprimer les emails sélectionnés"
                                            Visibility="{Binding AEmailsSelectionnes, Converter={StaticResource BoolToVis}}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding SupprimerEmailsSelectionnesWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</Grid>
								<TextBlock Text="Aucun email pour l'instant. Importez un fichier ou ajoutez une adresse ci-dessus."
                                           FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding AucunEmailListeApercu, Converter={StaticResource BoolToVis}}"/>
								<ItemsControl ItemsSource="{Binding EmailsListeApercu}" Margin="0,0,0,0">
									<ItemsControl.Style>
										<Style TargetType="ItemsControl">
											<Setter Property="Visibility" Value="Visible"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding AucunEmailListeApercu}" Value="True">
													<Setter Property="Visibility" Value="Collapsed"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</ItemsControl.Style>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
												<StackPanel Orientation="Horizontal">
													<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
													<TextBox Text="{Binding Email, Mode=TwoWay}" FontSize="11" Foreground="{DynamicResource NavyBrush}" FontFamily="Consolas" VerticalAlignment="Center"
                                                             BorderThickness="0" Background="Transparent" MinWidth="220"
                                                             ToolTip="Email modifiable"/>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<StackPanel Margin="0,0,0,12">
								<TextBlock Text="Date et horaire de lancement" FontSize="13" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
								<TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"
                                           Text="À partir de cette date et heure, les étudiants autorisés peuvent rejoindre l'examen sur le web (selon l'heure du serveur)."/>
								<TextBlock Text="Jour" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
								<DatePicker Style="{StaticResource ResultDatePicker}"
											SelectedDate="{Binding DateExamen, Mode=TwoWay}"
											FontSize="13"
											Padding="8,4"
											HorizontalAlignment="Stretch"
											Margin="0,0,0,12"/>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
									<TextBlock Text="Heure" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
									<ComboBox Style="{StaticResource ResultComboBox}" ItemsSource="{Binding ItemsHeures}" SelectedItem="{Binding HeureSelectionnee, Mode=TwoWay}" Width="76" Height="32" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
									<TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="600" Foreground="{DynamicResource NavyBrush}"/>
									<ComboBox Style="{StaticResource ResultComboBox}" ItemsSource="{Binding ItemsMinutes}" SelectedItem="{Binding MinuteSelectionnee, Mode=TwoWay}" Width="76" Height="32" Padding="8,4" VerticalContentAlignment="Center"/>
								</StackPanel>
								<TextBlock Text="Durée de l'épreuve (minutes)" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
								<Border CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBgBrush}" Padding="8,4" Margin="0,0,0,8">
									<TextBox Text="{Binding DureeMinutesEditable, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="13" Foreground="{DynamicResource NavyBrush}" BorderThickness="0" Background="Transparent"/>
								</Border>
								<TextBlock Text="{Binding LibelleCreneauResume}" FontSize="12" FontWeight="600" Foreground="{DynamicResource NavyBrush}" TextWrapping="Wrap"/>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding AfficherDetailQuestion, Converter={StaticResource BoolToVis}}">
					<Grid Margin="36,32,36,32">
					<StackPanel>

						<!-- En-tête : QUESTION n · Détails -->
						<StackPanel Margin="0,0,0,24">
							<TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="600"
                                       Text="{Binding QuestionSelectionnee.Numero, StringFormat='QUESTION {0}'}"/>
							<TextBlock Text="Détails de la question"
                                       FontSize="15" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,4,0,0"/>
						</StackPanel>

						<!-- Énoncé -->
						<TextBlock Text="ÉNONCÉ" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
						<Border Background="{DynamicResource CardBgBrush}" CornerRadius="10"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Padding="16,14" Margin="0,0,0,16">
							<TextBox Text="{Binding QuestionSelectionnee.Enonce,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="14" Foreground="{DynamicResource NavyBrush}" TextWrapping="Wrap"
                                     AcceptsReturn="True" MinHeight="60"/>
						</Border>

						<TextBlock Text="BARÈME (sur 20)" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
						<ComboBox Style="{StaticResource ResultComboBox}"
								  ItemsSource="{Binding ValeursBareme}"
								  SelectedItem="{Binding QuestionSelectionnee.BaremePoints, Mode=TwoWay}"
								  FontSize="13"
								  Width="180"
								  HorizontalAlignment="Left"
								  VerticalAlignment="Center"
								  Margin="0,0,0,16"/>

						<TextBlock Text="TEMPS INDICATIF (PASSAGE WEB)" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
						<Border Background="{DynamicResource CardBgBrush}" CornerRadius="10"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Padding="16,10" Margin="0,0,0,16">
							<StackPanel>
								<TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"
                                           Text="Durée de référence pour cette question lors du passage sur le web (décompte côté élève). La somme des temps de toutes les questions reste égale à la durée totale de l'épreuve : en changeant une question, les autres se rééquilibrent. Réglable avant publication."/>
								<ComboBox Style="{StaticResource ResultComboBox}"
										  ItemsSource="{Binding ValeursDureeSecondesIndicative}"
                                          SelectedItem="{Binding QuestionSelectionnee.DureeSecondesIndicative, Mode=TwoWay}"
                                          FontSize="13"
                                          HorizontalAlignment="Left"
                                          MinWidth="140">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding StringFormat={}{0} s}" FontSize="13"/>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>
						</Border>

						<!-- Import d’image sous l’énoncé (toutes les questions, optionnel) -->
						<StackPanel Margin="0,0,0,16">
							<TextBlock Text="IMAGE ASSOCIÉE" FontSize="10" FontWeight="700"
                                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>

							<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
								<Border CornerRadius="8" Padding="14,10" Cursor="Hand"
                                        Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" Margin="0,0,8,0">
									<Border.InputBindings>
										<MouseBinding MouseAction="LeftClick" Command="{Binding AttacherImageCommand}"/>
									</Border.InputBindings>
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="&#xE16C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource NavyBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
										<TextBlock FontSize="12" FontWeight="600" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="Attacher une image"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding QuestionSelectionnee.HasImage}" Value="True">
															<Setter Property="Text" Value="Changer l'image"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</StackPanel>
								</Border>
								<Border CornerRadius="8" Padding="14,10" Cursor="Hand"
                                        Background="{DynamicResource DangerZoneBgBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding QuestionSelectionnee.HasImage,
                                                     Converter={StaticResource BoolToVis}}">
									<Border.InputBindings>
										<MouseBinding MouseAction="LeftClick" Command="{Binding SupprimerImageCommand}"/>
									</Border.InputBindings>
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
										<TextBlock Text="Supprimer l'image"
                                                   FontSize="12" FontWeight="600" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
									</StackPanel>
								</Border>
							</StackPanel>

							<Border CornerRadius="10" Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Padding="12" MaxHeight="220"
                                    Visibility="{Binding QuestionSelectionnee.HasImage,
                                                 Converter={StaticResource BoolToVis}}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                               Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{Binding QuestionSelectionnee.ImageNom}"
                                                   FontSize="13" FontWeight="600" Foreground="{DynamicResource NavyBrush}"/>
										<TextBlock Text="Image stockée et sera sauvegardée avec l'examen"
                                                   FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
									</StackPanel>
								</StackPanel>
							</Border>

							<Border CornerRadius="10" Background="{DynamicResource BgBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Padding="16,12"
                                    Visibility="{Binding QuestionSelectionnee.HasImage,
                                                 Converter={StaticResource BoolToVisInverse}}">
								<TextBlock Text="Aucune image — cliquez sur « Attacher une image » pour en ajouter une"
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}" FontStyle="Italic"
                                           TextWrapping="Wrap"/>
							</Border>
						</StackPanel>

						<!-- Options QCM / CHECKBOX -->
						<StackPanel Visibility="{Binding QuestionSelectionnee.HasOptions,
                                                  Converter={StaticResource BoolToVis}}">



							<!-- Option A -->
							<Border Margin="0,0,0,8" CornerRadius="8" Padding="12,10">
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
										<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
										<Setter Property="BorderThickness" Value="1.5"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding QuestionSelectionnee.IsQCM}" Value="True"/>
													<Condition Binding="{Binding QuestionSelectionnee.ReponseCorrecte}" Value="A"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
											</MultiDataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding QuestionSelectionnee.IsVF}" Value="True"/>
													<Condition Binding="{Binding QuestionSelectionnee.ReponseCorrecte}" Value="A"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
											</MultiDataTrigger>
											<DataTrigger Binding="{Binding QuestionSelectionnee.OptionACorrecte}" Value="True">
												<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Border Width="28" Height="28" CornerRadius="7"
                                            Background="{DynamicResource InputBgBrush}" Margin="0,0,12,0"
                                            VerticalAlignment="Center">
										<TextBlock Text="A" FontSize="12" FontWeight="700"
                                                   Foreground="{DynamicResource SubTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
									</Border>
									<TextBox Grid.Column="1"
                                             Text="{Binding QuestionSelectionnee.OptionA,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="13" Foreground="{DynamicResource NavyBrush}"
                                             VerticalAlignment="Center"/>

									<!-- QCM : icône MDL2 (style quiz — ligne verte + coche) -->
									<Border Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Visibility="{Binding QuestionSelectionnee.IsQcmOuVf,
                                                         Converter={StaticResource BoolToVis}}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SetReponseCorrecteCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                          CommandParameter="A"/>
										</Border.InputBindings>
										<TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="&#xE719;"/>
													<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding QuestionSelectionnee.ReponseCorrecte}" Value="A">
															<Setter Property="Text" Value="&#xE73E;"/>
															<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>

									<CheckBox Grid.Column="2" Margin="12,0,0,0"
                                              IsChecked="{Binding QuestionSelectionnee.OptionACorrecte}"
                                              Visibility="{Binding QuestionSelectionnee.IsCheckbox,
                                                           Converter={StaticResource BoolToVis}}"/>
								</Grid>
							</Border>

							<!-- Option B -->
							<Border Margin="0,0,0,8" CornerRadius="8" Padding="12,10">
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
										<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
										<Setter Property="BorderThickness" Value="1.5"/>
										<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding QuestionSelectionnee.IsQCM}" Value="True"/>
													<Condition Binding="{Binding QuestionSelectionnee.ReponseCorrecte}" Value="B"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>

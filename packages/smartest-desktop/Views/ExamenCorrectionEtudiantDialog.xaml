<Window x:Class="smartest_desktop.Views.ExamenCorrectionEtudiantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Correction"
        Width="640"
        MinWidth="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#fafbfd"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="20,18" BorderBrush="#e2e8f4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding TitreFenetre}" FontSize="16" FontWeight="700" Foreground="#0f1e3d" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Erreur}" Foreground="#b91c1c" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding AfficherErreur, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Lignes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="10"
                                    Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SousTitre}" FontSize="11" Foreground="#64748b" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Enonce}" FontSize="13" Foreground="#0f1e3d" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="Réponse : " FontWeight="SemiBold"/>
                                        <Run Text="{Binding ReponseLibelle}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Note" VerticalAlignment="Center" FontSize="12" Foreground="#64748b" Margin="0,0,8,0"/>
                                        <TextBox Width="80" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#94a3b8" Margin="8,0,0,0">
                                            <Run Text="/ max "/>
                                            <Run Text="{Binding PointsMax, StringFormat={}{0:0.##}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="700" Foreground="#0f1e3d">
                    <Run Text="Total : "/>
                    <Run Text="{Binding NoteTotale, Mode=OneWay, StringFormat={}{0:0.##}}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding Bareme, StringFormat={}{0:0.##}}"/>
                </TextBlock>
                <Button Grid.Column="1" Content="Valider et publier" Padding="16,8"
                        Command="{Binding ValiderCommand}" Style="{StaticResource PrimaryBtn}"/>
            </Grid>
        </Grid>
    </Border>
</Window>

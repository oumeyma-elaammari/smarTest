<Window x:Class="smartest_desktop.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:smartest_desktop.ViewModels"
        xmlns:views="clr-namespace:smartest_desktop.Views"
        Title="SmarTest — Shell"
        Icon="/Assets/SmarTest-AppIcon.png"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding ShowShellChrome, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="22,28,22,32">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center">
                            Smar<Run Foreground="{DynamicResource AccentBrush}">Test</Run>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Espace professeur" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="16,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0">
                    <Border Margin="0,1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource MenuPopupItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHome}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoHomeCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontSize="13" Foreground="{DynamicResource SubTextBrush}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Home" FontSize="13" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource MenuPopupItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuizExamens}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoQuizExamensCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D5;" FontSize="13" Foreground="{DynamicResource SubTextBrush}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Quiz et examens" FontSize="13" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource MenuPopupItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessions}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoSessionsCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontSize="13" Foreground="{DynamicResource SubTextBrush}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Sessions examens" FontSize="13" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource MenuPopupItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatistiques}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoStatistiquesCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D2;" FontSize="13" Foreground="{DynamicResource SubTextBrush}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Statistiques" FontSize="13" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource MenuPopupItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsParametres}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoParametresCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontSize="13" Foreground="{DynamicResource SubTextBrush}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Paramètres" FontSize="13" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="12,0,12,18">
                    <Border Background="{DynamicResource UserInfoBgBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource UserInfoBorderBrush}" BorderThickness="1"
                            Padding="8,6" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding SettingsAccount.Nom}" FontSize="13" FontWeight="600" Foreground="{DynamicResource NavyBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SettingsAccount.Email}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MenuPopupItem}" Margin="0,2">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding LogoutCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xF3B1;" FontSize="13" Foreground="{DynamicResource DangerBrush}" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
                            <TextBlock Text="Déconnexion" FontSize="13" Foreground="{DynamicResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ClipToBounds="True">
                <ContentControl x:Name="CentralHostedContent"
                                Visibility="{Binding IsCentralHosted, Converter={StaticResource BoolToVis}}"/>

                <views:SessionsActivesView Margin="16,8,16,0"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           DataContext="{Binding SessionsActives}"
                                           Visibility="{Binding DataContext.IsSessions, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                <views:SettingsAccountView Margin="30"
                                           DataContext="{Binding SettingsAccount}"
                                           Visibility="{Binding DataContext.IsParametres, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource FooterBarBgBrush}"
                    BorderBrush="{DynamicResource FooterBarBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="18,14"
                    Visibility="{Binding ShowShellChrome, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="SmarTest — ENSA Oujda · Génie Informatique · 2025–2026"
                           FontSize="11" Foreground="{DynamicResource FooterBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>

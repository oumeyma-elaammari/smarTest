<Window x:Class="smartest_desktop.Views.StatistiquesProfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:smartest_desktop.Views"
        Title="SmarTest — Statistiques et résultats"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#fafbfd"
        FontFamily="Segoe UI">


	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="230"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- ══ SIDEBAR (alignée QuizExamen / Dashboard) ══ -->
		<Border Grid.Column="0" Background="White"
                BorderBrush="#e2e8f4" BorderThickness="0,0,1,0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Margin="22,28,22,32">
					<StackPanel Orientation="Horizontal">
						<Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock FontFamily="Georgia" FontSize="18" FontWeight="Bold"
						   Foreground="{StaticResource NavyBrush}" VerticalAlignment="Center">
							Smar<Run Foreground="{StaticResource AccentBrush}">Test</Run>
						</TextBlock>
					</StackPanel>
					<TextBlock Text="Espace professeur" FontSize="11" Foreground="#8899b8" Margin="16,5,0,0"/>
				</StackPanel>

				<StackPanel Grid.Row="1" Margin="12,0">
					<Border Style="{StaticResource MenuPopupItem}" Margin="0,1">
						<Border.InputBindings>
							<MouseBinding MouseAction="LeftClick" Command="{Binding RetourDashboardCommand}"/>
						</Border.InputBindings>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="&#xE80F;" FontSize="13" Foreground="#6b7a99"
                                       FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
							<TextBlock Text="Home" FontSize="13" Foreground="#0f1e3d"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource MenuPopupItem}" Margin="0,1">
						<Border.InputBindings>
							<MouseBinding MouseAction="LeftClick" Command="{Binding OuvrirQuizExamenCommand}"/>
						</Border.InputBindings>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="&#xE9D5;" FontSize="13" Foreground="#6b7a99"
                                       FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
							<TextBlock Text="Quiz et examens" FontSize="13" Foreground="#0f1e3d"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource MenuPopupItem}" Margin="0,1">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="&#xE7FC;" FontSize="13" Foreground="#6b7a99"
                                       FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
							<TextBlock Text="Sessions actives" FontSize="13" Foreground="#0f1e3d"/>
						</StackPanel>
					</Border>

					<Border CornerRadius="8" Height="40" Padding="14,0" Background="#0f1e3d" Margin="0,1">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="&#xE9D2;" FontSize="13" Foreground="White"
                                       FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
							<TextBlock Text="Statistiques" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource MenuPopupItem}" Margin="0,1">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="&#xE713;" FontSize="13" Foreground="#6b7a99"
                                       FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
							<TextBlock Text="Paramètres" FontSize="13" Foreground="#0f1e3d"/>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Row="2" Margin="12,0,12,18">
					<Border Background="#f0f3f9" CornerRadius="10" BorderBrush="#e2e8f4"
                            BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
						<StackPanel>
							<StackPanel Orientation="Horizontal" Margin="0,0,0,3">
								<Ellipse Width="7" Height="7" Fill="#16a34a"
                                         VerticalAlignment="Center" Margin="0,0,7,0"/>
								<TextBlock Text="{Binding Nom}" FontSize="13" FontWeight="600" Foreground="#0f1e3d"/>
							</StackPanel>
							<TextBlock Text="{Binding Email}" FontSize="11" Foreground="#8899b8" Margin="14,0,0,0"/>
						</StackPanel>
					</Border>
					<Border Style="{StaticResource MenuPopupItem}" Margin="0,2">
						<Border.InputBindings>
							<MouseBinding MouseAction="LeftClick" Command="{Binding LogoutCommand}"/>
						</Border.InputBindings>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<TextBlock Text="&#xF3B1;" FontSize="13" Foreground="#dc2626"
                                       FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0"/>
							<TextBlock Text="Déconnexion" FontSize="13" Foreground="#dc2626"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENU ══ -->
		<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="#fafbfd">
			<views:StatistiquesDashboardView x:Name="Dashboard" Margin="40,36,40,40"/>
		</ScrollViewer>
	</Grid>
</Window>

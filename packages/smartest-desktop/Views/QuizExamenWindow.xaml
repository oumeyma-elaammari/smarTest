<Window x:Class="smartest_desktop.Views.QuizExamenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:smartest_desktop.ViewModels"
        Title="SmarTest — Quiz et Examens"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#fafbfd"
        FontFamily="Segoe UI">

	<Window.DataContext>
		<vm:QuizExamenViewModel />
	</Window.DataContext>

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<!-- Badge statut Quiz -->
			<Style x:Key="BadgeBrouillon" TargetType="Border">
				<Setter Property="Background" Value="#fff7ed"/>
				<Setter Property="CornerRadius" Value="6"/>
				<Setter Property="Padding" Value="6,5"/>
			</Style>
			<Style x:Key="BadgePublie" TargetType="Border">
				<Setter Property="Background" Value="#eaf3de"/>
				<Setter Property="CornerRadius" Value="6"/>
				<Setter Property="Padding" Value="6,5"/>
			</Style>
			<Style x:Key="BadgePlanifie" TargetType="Border">
				<Setter Property="Background" Value="#eef3fd"/>
				<Setter Property="CornerRadius" Value="6"/>
				<Setter Property="Padding" Value="6,5"/>
			</Style>

			<!-- Bouton action table -->
			<Style x:Key="ActionBtn" TargetType="Button">
				<Setter Property="Height" Value="30"/>
				<Setter Property="MinWidth" Value="58"/>
				<Setter Property="Padding" Value="10,5"/>
				<Setter Property="FontSize" Value="11"/>
				<Setter Property="FontWeight" Value="600"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
									Padding="{TemplateBinding Padding}"
                                    CornerRadius="6">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Opacity" Value="0.85"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="PaginationArrowBtn" TargetType="Button">
				<Setter Property="Height" Value="30"/>
				<Setter Property="MinWidth" Value="23"/>
				<Setter Property="Padding" Value="2,1"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Foreground" Value="#0f1e3d"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bg" Property="Background" Value="#e8eef8"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!-- Suppression : icône, fond léger, padding minimal -->
			<Style x:Key="IconDeleteBtn" TargetType="Button">
				<Setter Property="Width" Value="26"/>
				<Setter Property="Height" Value="26"/>
				<Setter Property="MinWidth" Value="26"/>
				<Setter Property="Padding" Value="2"/>
				<Setter Property="Background" Value="#FEF2F2"/>
				<Setter Property="BorderBrush" Value="#FEF2F2"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="BdIconDelete"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="BdIconDelete" Property="Background" Value="#FEE2E2"/>
									<Setter TargetName="BdIconDelete" Property="BorderBrush" Value="#FCA5A5"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<!-- ══ MAIN CONTENT ══ -->
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="white">
				<StackPanel Margin="40,36,40,40">

					<!-- Header -->
					<StackPanel Margin="0,0,0,28">
						<TextBlock Text="Mes évaluations" FontSize="22" FontWeight="700" Foreground="#0f1e3d"/>
					</StackPanel>

					<!-- Cartes action -->
					<UniformGrid Columns="2" Margin="0,0,0,36">
						<Border Margin="0,0,8,0" Cursor="Hand" CornerRadius="14"
                                BorderThickness="1.5" Background="White">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding GenererQuizCommand}"/>
							</Border.InputBindings>
							<Border.Effect>
								<DropShadowEffect BlurRadius="12" Opacity="0.05" ShadowDepth="3" Direction="270"/>
							</Border.Effect>
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="BorderBrush" Value="#e2e8f4"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="BorderBrush" Value="#0f1e3d"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid Margin="22,20,22,20">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Border Width="42" Height="42" CornerRadius="10" Background="#0f1e3d"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
									<TextBlock Text="&#xE9D5;" FontSize="18" Foreground="White"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="Générer un quiz" FontSize="14" FontWeight="700" Foreground="#0f1e3d" Margin="0,0,0,4"/>
									<TextBlock Text="QCM depuis un cours importé"
                                               FontSize="12" Foreground="#8899b8" TextWrapping="Wrap"/>
								</StackPanel>
							</Grid>
						</Border>

						<Border Margin="8,0,0,0" Cursor="Hand" CornerRadius="14"
                                BorderThickness="1.5" Background="White">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding GenererExamenCommand}"/>
							</Border.InputBindings>
							<Border.Effect>
								<DropShadowEffect BlurRadius="12" Opacity="0.05" ShadowDepth="3" Direction="270"/>
							</Border.Effect>
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="BorderBrush" Value="#e2e8f4"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="BorderBrush" Value="#0f1e3d"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid Margin="22,20,22,20">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Border Width="42" Height="42" CornerRadius="10" Background="#0f1e3d"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
									<TextBlock Text="&#xE9D2;" FontSize="18" Foreground="White"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="Créer un examen" FontSize="14" FontWeight="700" Foreground="#0f1e3d" Margin="0,0,0,4"/>
									<TextBlock Text="Types variés depuis un cours importé"
                                               FontSize="12" Foreground="#8899b8" TextWrapping="Wrap"/>
								</StackPanel>
							</Grid>
						</Border>
					</UniformGrid>

					<!-- ══ MES QUIZ ══ -->
					<Border Style="{StaticResource DashCard}" Padding="24,20" Margin="0,0,0,20">
						<StackPanel>

							<!-- Titre + recherche -->
							<Grid Margin="0,0,0,16">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="280"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Mes Quiz" FontSize="15" FontWeight="600" Foreground="#0f1e3d"/>
									<TextBlock FontSize="12" Foreground="#8899b8" Margin="0,3,0,0" TextWrapping="Wrap">
										<Run Text="{Binding TotalQuiz, Mode=OneWay}"/>
										<Run Text=" quiz enregistrés"/>
									</TextBlock>
								</StackPanel>
								<StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
									<TextBlock Text="Rechercher" FontSize="11" FontWeight="600" Foreground="#8899b8" Margin="0,0,0,4"/>
									<TextBox Text="{Binding FiltreQuiz, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,5" FontSize="11"
                                         BorderBrush="#e2e8f4" BorderThickness="1"
                                         Background="White" VerticalContentAlignment="Center">
										<TextBox.Resources>
											<Style TargetType="Border">
												<Setter Property="CornerRadius" Value="8"/>
											</Style>
										</TextBox.Resources>
									</TextBox>
								</StackPanel>
							</Grid>

							<Border Height="1" Background="#e2e8f4" Margin="0,0,0,0"/>

							<!-- En-têtes colonnes (masqués si liste vide) -->
							<Grid Margin="0,12,0,8"
                                  Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="90"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="250"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Titre" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="1" Text="Difficulté" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="2" Text="Questions" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="3" Text="Statut" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="4" Text="Actions" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
							</Grid>
							<Border Height="1" Background="#f0f3f9" Margin="0,0,0,4"
                                    Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}"/>

							<!-- Liste quiz (page courante) -->
							<ItemsControl ItemsSource="{Binding QuizPage}"
                                          Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="0,10" BorderBrush="#f0f3f9" BorderThickness="0,0,0,1">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="100"/>
													<ColumnDefinition Width="90"/>
													<ColumnDefinition Width="80"/>
													<ColumnDefinition Width="250"/>
												</Grid.ColumnDefinitions>

												<StackPanel Grid.Column="0" VerticalAlignment="Center">
													<TextBlock Text="{Binding TitreAffiche}" FontSize="13"
                                                               FontWeight="600" Foreground="#0f1e3d"
                                                               Cursor="Hand" >
														<TextBlock.InputBindings>
															<MouseBinding MouseAction="LeftClick"
																		  Command="{Binding DataContext.OuvrirQuizCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
																		  CommandParameter="{Binding}"/>
														</TextBlock.InputBindings>
													</TextBlock>
													<TextBlock Text="{Binding Quiz.CoursSourceTitre}" FontSize="11"
                                                               Foreground="#8899b8" Margin="0,2,0,0"/>
												</StackPanel>

												<TextBlock Grid.Column="1" Text="{Binding Quiz.Difficulte}"
                                                           FontSize="12" Foreground="#6b7a99"
                                                           VerticalAlignment="Center"/>

												<TextBlock Grid.Column="2" Text="{Binding Quiz.NombreQuestions}"
                                                           FontSize="12" Foreground="#6b7a99"
                                                           VerticalAlignment="Center"/>

												<!-- Badge statut -->
												<Border Grid.Column="3" CornerRadius="6" Padding="8,3"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="#fff7ed"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Publié">
																	<Setter Property="Background" Value="#eaf3de"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Validé">
																	<Setter Property="Background" Value="#eef3fd"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock FontSize="10" FontWeight="700">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Text" Value="{Binding Quiz.Statut}"/>
																<Setter Property="Foreground" Value="#c2410c"/>
																<Style.Triggers>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Publié">
																	<Setter Property="Foreground" Value="#16a34a"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Validé">
																	<Setter Property="Foreground" Value="#4f8ef7"/>
																</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>

												<!-- Actions -->
												<StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
													<Button Background="#ecfeff" BorderBrush="#bae6fd"
                                                            Foreground="#0369a1" Margin="0,0,6,0"
                                                            ToolTip="Ouvre une session en direct (QR + lien). Connexion professeur requise."
                                                            Command="{Binding DataContext.OuvrirCodeQrQuizCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="#ecfeff"/>
																<Setter Property="BorderBrush" Value="#bae6fd"/>
																<Setter Property="Foreground" Value="#0369a1"/>
																<Style.Triggers>
																	<Trigger Property="IsEnabled" Value="False">
																		<Setter Property="Opacity" Value="0.45"/>
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<TextBlock Text="Code QR"/>
													</Button>
													<Button Background="#eef3fd" BorderBrush="#eef3fd"
                                                            Foreground="#4f8ef7" Margin="0,0,6,0"
                                                            IsEnabled="{Binding PeutPublier}"
                                                            Command="{Binding DataContext.PublierSurLeWebCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="#eef3fd"/>
																<Setter Property="BorderBrush" Value="#eef3fd"/>
																<Setter Property="Foreground" Value="#4f8ef7"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding IsPublicationEnCours}" Value="True">
																		<Setter Property="Background" Value="#e2e8f4"/>
																		<Setter Property="BorderBrush" Value="#e2e8f4"/>
																		<Setter Property="Foreground" Value="#64748b"/>
																	</DataTrigger>
																	<Trigger Property="IsEnabled" Value="False">
																		<Setter Property="Opacity" Value="0.45"/>
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<TextBlock Text="{Binding LibelleBoutonPublication}"/>
													</Button>
													<Button Style="{StaticResource IconDeleteBtn}"
                                                            ToolTip="Supprimer ce quiz"
                                                            Command="{Binding DataContext.SupprimerQuizCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                    Foreground="#DC2626"/>
													</Button>
												</StackPanel>

											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Pagination quiz -->
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                                        Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}">
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="0,0,8,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding QuizPagePrecedenteCommand}">
									<TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
								<TextBlock Text="{Binding LibellePaginationQuiz}" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="600" Foreground="#6b7a99" Margin="8,0"/>
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="8,0,0,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding QuizPageSuivanteCommand}">
									<TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
							</StackPanel>

							<!-- État vide quiz -->
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoQuiz, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun quiz créé pour le moment"
                                           FontSize="13" Foreground="#8899b8" HorizontalAlignment="Center"/>
							</StackPanel>
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoQuizRecherche, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun quiz ne correspond à la recherche"
                                           FontSize="13" Foreground="#8899b8" HorizontalAlignment="Center"/>
							</StackPanel>

						</StackPanel>
					</Border>

					<!-- ══ MES EXAMENS ══ -->
					<Border Style="{StaticResource DashCard}" Padding="24,20">
						<StackPanel>

							<Grid Margin="0,0,0,16">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="280"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Mes Examens" FontSize="15" FontWeight="600" Foreground="#0f1e3d"/>
									<TextBlock FontSize="12" Foreground="#8899b8" Margin="0,3,0,0" TextWrapping="Wrap">
										<Run Text="{Binding TotalExamens, Mode=OneWay}"/>
										<Run Text="examens enregistrés"/>
									</TextBlock>
								</StackPanel>
								<StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
									<TextBlock Text="Rechercher" FontSize="11" FontWeight="600" Foreground="#8899b8" Margin="0,0,0,4"/>
									<TextBox Text="{Binding FiltreExamen, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,5" FontSize="11"
                                         BorderBrush="#e2e8f4" BorderThickness="1"
                                         Background="White" VerticalContentAlignment="Center">
										<TextBox.Resources>
											<Style TargetType="Border">
												<Setter Property="CornerRadius" Value="8"/>
											</Style>
										</TextBox.Resources>
									</TextBox>
								</StackPanel>
							</Grid>

							<Border Height="1" Background="#e2e8f4" Margin="0,0,0,0"/>

							<!-- En-têtes -->
							<Grid Margin="0,12,0,8"
                                  Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="120"/>
									<ColumnDefinition Width="90"/>
									<ColumnDefinition Width="280"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Titre" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="1" Text="Durée" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="2" Text="Date prévue" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="3" Text="Statut" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
								<TextBlock Grid.Column="4" Text="Actions" FontSize="11" FontWeight="600" Foreground="#8899b8"/>
							</Grid>

							<Border Height="1" Background="#f0f3f9" Margin="0,0,0,4"
                                    Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}"/>

							<!-- Liste examens (page courante) -->
							<ItemsControl ItemsSource="{Binding ExamensPage}"
                                          Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="0,10" BorderBrush="#f0f3f9" BorderThickness="0,0,0,1">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="80"/>
													<ColumnDefinition Width="120"/>
													<ColumnDefinition Width="90"/>
													<ColumnDefinition Width="280"/>
												</Grid.ColumnDefinitions>

												<TextBlock Grid.Column="0" Text="{Binding TitreAffiche}"
                                                           FontSize="13" FontWeight="600"
                                                           Foreground="#0f1e3d" VerticalAlignment="Center"
                                                           Cursor="Hand" >
													<TextBlock.InputBindings>
														<MouseBinding MouseAction="LeftClick"
																	  Command="{Binding DataContext.OuvrirExamenCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
																	  CommandParameter="{Binding}"/>
													</TextBlock.InputBindings>
												</TextBlock>

												<TextBlock Grid.Column="1" FontSize="12"
                                                           Foreground="#6b7a99" VerticalAlignment="Center">
													<Run Text="{Binding Examen.Duree}"/>
													<Run Text=" min"/>
												</TextBlock>

												<TextBlock Grid.Column="2" FontSize="12"
                                                           Foreground="#6b7a99" VerticalAlignment="Center"
                                                           Text="{Binding Examen.DatePrevue, StringFormat='{}{0:d MMM yyyy HH:mm}', TargetNullValue='Non définie'}"/>

												<!-- Badge statut -->
												<Border Grid.Column="3" CornerRadius="6" Padding="8,3"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="#fff7ed"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Examen.Statut}" Value="PUBLIE">
																	<Setter Property="Background" Value="#eef3fd"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Examen.Statut}" Value="EN_COURS">
																	<Setter Property="Background" Value="#eaf3de"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Examen.Statut}" Value="TERMINE">
																	<Setter Property="Background" Value="#f0f3f9"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock FontSize="10" FontWeight="700">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Text" Value="{Binding Examen.Statut}"/>
																<Setter Property="Foreground" Value="#c2410c"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Examen.Statut}" Value="PUBLIE">
																		<Setter Property="Foreground" Value="#4f8ef7"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Examen.Statut}" Value="EN_COURS">
																		<Setter Property="Foreground" Value="#16a34a"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Examen.Statut}" Value="TERMINE">
																		<Setter Property="Foreground" Value="#8899b8"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>

												<!-- Actions -->
												<StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
													<Button Style="{StaticResource ActionBtn}"
                                                            Background="#eef3fd" BorderBrush="#cfe0fc"
                                                            Foreground="#1a2e5a" Margin="0,0,6,0" Padding="10,6"
                                                            Command="{Binding DataContext.PublierExamenSurLeWebCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
														<TextBlock Text="Publier"/>
													</Button>
													<Button Style="{StaticResource ActionBtn}"
                                                            Background="#eaf3de" BorderBrush="#eaf3de"
                                                            Foreground="#16a34a" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.LancerExamenCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<TextBlock Text="Lancer"/>
													</Button>
													<Button Style="{StaticResource IconDeleteBtn}"
                                                            ToolTip="Supprimer cet examen"
                                                            Command="{Binding DataContext.SupprimerExamenCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                    Foreground="#DC2626"/>
													</Button>
												</StackPanel>

											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Pagination examens -->
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                                        Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}">
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="0,0,8,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding ExamenPagePrecedenteCommand}">
									<TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
								<TextBlock Text="{Binding LibellePaginationExamen}" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="600" Foreground="#6b7a99" Margin="8,0"/>
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="8,0,0,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding ExamenPageSuivanteCommand}">
									<TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
							</StackPanel>

							<!-- État vide examens -->
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoExamens, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun examen créé pour le moment"
                                           FontSize="13" Foreground="#8899b8" HorizontalAlignment="Center"/>
							</StackPanel>
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoExamensRecherche, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun examen ne correspond à la recherche"
                                           FontSize="13" Foreground="#8899b8" HorizontalAlignment="Center"/>
							</StackPanel>

						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>

		</Grid>
	</Grid>
</Window>

<Window x:Class="smartest_desktop.Views.QuizExamenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:smartest_desktop.ViewModels"
        Title="SmarTest — Quiz et Examens"
        Icon="/Assets/SmarTest-AppIcon.png"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

	<Window.DataContext>
		<vm:QuizExamenViewModel />
	</Window.DataContext>

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<!-- Badge statut Quiz -->
			<Style x:Key="BadgeBrouillon" TargetType="Border">
				<Setter Property="Background" Value="{DynamicResource WarnLightBgBrush}"/>
				<Setter Property="CornerRadius" Value="6"/>
				<Setter Property="Padding" Value="6,5"/>
			</Style>
			<Style x:Key="BadgePublie" TargetType="Border">
				<Setter Property="Background" Value="{DynamicResource AlertSuccessBgBrush}"/>
				<Setter Property="CornerRadius" Value="6"/>
				<Setter Property="Padding" Value="6,5"/>
			</Style>
			<Style x:Key="BadgePlanifie" TargetType="Border">
				<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
				<Setter Property="CornerRadius" Value="6"/>
				<Setter Property="Padding" Value="6,5"/>
			</Style>

			<!-- Bouton action table -->
			<Style x:Key="ActionBtn" TargetType="Button">
				<Setter Property="Height" Value="30"/>
				<Setter Property="MinWidth" Value="58"/>
				<Setter Property="Padding" Value="10,5"/>
				<Setter Property="FontSize" Value="11"/>
				<Setter Property="FontWeight" Value="600"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
									Padding="{TemplateBinding Padding}"
                                    CornerRadius="6">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter Property="Opacity" Value="0.85"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="PaginationArrowBtn" TargetType="Button">
				<Setter Property="Height" Value="30"/>
				<Setter Property="MinWidth" Value="23"/>
				<Setter Property="Padding" Value="2,1"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Foreground" Value="{DynamicResource NavyBrush}"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Bg" Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<!-- Suppression : icône, fond léger, padding minimal -->
			<Style x:Key="IconDeleteBtn" TargetType="Button">
				<Setter Property="Width" Value="26"/>
				<Setter Property="Height" Value="26"/>
				<Setter Property="MinWidth" Value="26"/>
				<Setter Property="Padding" Value="2"/>
				<Setter Property="Background" Value="{DynamicResource DangerZoneBgBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource DangerZoneBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Border x:Name="BdIconDelete"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="BdIconDelete" Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
									<Setter TargetName="BdIconDelete" Property="BorderBrush" Value="{DynamicResource DangerZoneBorderBrush}"/>
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="BdIconDelete" Property="Opacity" Value="0.35"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<!-- ══ MAIN CONTENT ══ -->
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="{DynamicResource WindowBgBrush}">
				<StackPanel Margin="40,36,40,40">

					<!-- Header -->
					<StackPanel Margin="0,0,0,28">
						<TextBlock Text="Mes évaluations" FontSize="22" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
					</StackPanel>

					<!-- Cartes action -->
					<UniformGrid Columns="2" Margin="0,0,0,36">
						<Border Margin="0,0,8,0" Cursor="Hand" CornerRadius="14"
                                BorderThickness="1.5" Background="{DynamicResource CardBgBrush}">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding GenererQuizCommand}"/>
							</Border.InputBindings>
							<Border.Effect>
								<DropShadowEffect BlurRadius="12" Opacity="0.05" ShadowDepth="3" Direction="270"/>
							</Border.Effect>
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="BorderBrush" Value="{DynamicResource NavyBrush}"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid Margin="22,20,22,20">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentLightBgBrush}"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
									<TextBlock Text="&#xE9D5;" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="Générer un quiz" FontSize="14" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,0,0,4"/>
									<TextBlock Text="QCM depuis un cours importé"
                                               FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
								</StackPanel>
							</Grid>
						</Border>

						<Border Margin="8,0,0,0" Cursor="Hand" CornerRadius="14"
                                BorderThickness="1.5" Background="{DynamicResource CardBgBrush}">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding GenererExamenCommand}"/>
							</Border.InputBindings>
							<Border.Effect>
								<DropShadowEffect BlurRadius="12" Opacity="0.05" ShadowDepth="3" Direction="270"/>
							</Border.Effect>
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="BorderBrush" Value="{DynamicResource NavyBrush}"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid Margin="22,20,22,20">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource AccentLightBgBrush}"
                                        Margin="0,0,16,0" VerticalAlignment="Center">
									<TextBlock Text="&#xE9D2;" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="Générer un examen" FontSize="14" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,0,0,4"/>
									<TextBlock Text="Types variés depuis un cours importé"
                                               FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
								</StackPanel>
							</Grid>
						</Border>
					</UniformGrid>

					<!-- ══ MES QUIZ ══ -->
					<Border Style="{StaticResource DashCard}" Padding="24,20" Margin="0,0,0,20">
						<StackPanel>

							<!-- Titre + recherche -->
							<Grid Margin="0,0,0,16">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="280"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Mes Quiz" FontSize="15" FontWeight="600" Foreground="{DynamicResource NavyBrush}"/>
									<TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap">
										<Run Text="{Binding TotalQuiz, Mode=OneWay}"/>
										<Run Text=" quiz enregistrés"/>
									</TextBlock>
								</StackPanel>
								<StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
									<TextBlock Text="Rechercher" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
									<TextBox Text="{Binding FiltreQuiz, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,5" FontSize="11"
                                         BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                         Background="{DynamicResource BgBrush}" VerticalContentAlignment="Center">
										<TextBox.Resources>
											<Style TargetType="Border">
												<Setter Property="CornerRadius" Value="8"/>
											</Style>
										</TextBox.Resources>
									</TextBox>
								</StackPanel>
							</Grid>

							<Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,0"/>

							<!-- En-têtes colonnes (masqués si liste vide) -->
							<Grid Margin="0,12,0,8"
                                  Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="90"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="250"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Titre" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="1" Text="Difficulté" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="2" Text="Questions" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="3" Text="Statut" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="4" Text="Actions" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
							</Grid>
							<Border Height="1" Background="{DynamicResource BgBrush}" Margin="0,0,0,4"
                                    Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}"/>

							<!-- Liste quiz (page courante) -->
							<ItemsControl ItemsSource="{Binding QuizPage}"
                                          Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="0,10" BorderBrush="{DynamicResource BgBrush}" BorderThickness="0,0,0,1">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="100"/>
													<ColumnDefinition Width="90"/>
													<ColumnDefinition Width="80"/>
													<ColumnDefinition Width="250"/>
												</Grid.ColumnDefinitions>

												<StackPanel Grid.Column="0" VerticalAlignment="Center">
													<TextBlock Text="{Binding TitreAffiche}" FontSize="13"
                                                               FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Cursor="Hand" >
														<TextBlock.InputBindings>
															<MouseBinding MouseAction="LeftClick"
																		  Command="{Binding DataContext.OuvrirQuizCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
																		  CommandParameter="{Binding}"/>
														</TextBlock.InputBindings>
													</TextBlock>
													<TextBlock Text="{Binding Quiz.CoursSourceTitre}" FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
												</StackPanel>

												<TextBlock Grid.Column="1" Text="{Binding Quiz.Difficulte}"
                                                           FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                                           VerticalAlignment="Center"/>

												<TextBlock Grid.Column="2" Text="{Binding Quiz.NombreQuestions}"
                                                           FontSize="12" Foreground="{DynamicResource SubTextBrush}"
                                                           VerticalAlignment="Center"/>

												<!-- Badge statut -->
												<Border Grid.Column="3" CornerRadius="6" Padding="8,3"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="{DynamicResource WarnLightBgBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Publié">
																	<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Validé">
																	<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock FontSize="10" FontWeight="700">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Text" Value="{Binding Quiz.Statut}"/>
																<Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
																<Style.Triggers>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Publié">
																	<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Quiz.Statut}" Value="Validé">
																	<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
																</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>

												<!-- Actions -->
												<StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
													<Button Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                            Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                                            ToolTip="Ouvre une session en direct (QR + lien). Connexion professeur requise."
                                                            Command="{Binding DataContext.OuvrirCodeQrQuizCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
																<Style.Triggers>
																	<Trigger Property="IsEnabled" Value="False">
																		<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
																		<Setter Property="Opacity" Value="0.7"/>
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<TextBlock Text="Code QR"/>
													</Button>
													<Button Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource AccentLightBgBrush}"
                                                            Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                                            IsEnabled="{Binding PeutPublier}"
                                                            Command="{Binding DataContext.PublierSurLeWebCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding IsPublicationEnCours}" Value="True">
																		<Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
																	</DataTrigger>
																	<Trigger Property="IsEnabled" Value="False">
																		<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
																		<Setter Property="Opacity" Value="0.7"/>
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<TextBlock Text="{Binding LibelleBoutonPublication}"/>
													</Button>
													<Button Style="{StaticResource IconDeleteBtn}"
                                                            ToolTip="Supprimer ce quiz"
                                                            Command="{Binding DataContext.SupprimerQuizCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                    Foreground="{DynamicResource DangerBrush}"/>
													</Button>
												</StackPanel>

											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Pagination quiz -->
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                                        Visibility="{Binding AfficherListeQuiz, Converter={StaticResource BoolToVis}}">
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="0,0,8,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding QuizPagePrecedenteCommand}">
									<TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
								<TextBlock Text="{Binding LibellePaginationQuiz}" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="600" Foreground="{DynamicResource SubTextBrush}" Margin="8,0"/>
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="8,0,0,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding QuizPageSuivanteCommand}">
									<TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
							</StackPanel>

							<!-- État vide quiz -->
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoQuiz, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun quiz créé pour le moment"
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
							</StackPanel>
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoQuizRecherche, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun quiz ne correspond à la recherche"
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
							</StackPanel>

						</StackPanel>
					</Border>

					<!-- ══ MES EXAMENS ══ (même structure / style visuel que Mes Quiz) -->
					<Border Style="{StaticResource DashCard}" Padding="24,20" Margin="0,0,0,20">
						<StackPanel>

							<Grid Margin="0,0,0,16">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="280"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0">
									<TextBlock Text="Mes Examens" FontSize="15" FontWeight="600" Foreground="{DynamicResource NavyBrush}"/>
									<TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap">
										<Run Text="{Binding TotalExamens, Mode=OneWay}"/>
										<Run Text=" examens enregistrés"/>
									</TextBlock>
								</StackPanel>
								<StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
									<TextBlock Text="Rechercher" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
									<TextBox Text="{Binding FiltreExamen, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="6,5" FontSize="11"
                                         BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                         Background="{DynamicResource BgBrush}" VerticalContentAlignment="Center">
										<TextBox.Resources>
											<Style TargetType="Border">
												<Setter Property="CornerRadius" Value="8"/>
											</Style>
										</TextBox.Resources>
									</TextBox>
								</StackPanel>
							</Grid>

							<Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,0"/>

							<!-- En-têtes -->
							<Grid Margin="0,12,0,8"
                                  Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}">
								<!-- Colonnes 1–4 : mêmes largeurs que « Mes Quiz » pour égaler la colonne Titre (*) -->
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="100"/>
									<ColumnDefinition Width="90"/>
									<ColumnDefinition Width="80"/>
									<ColumnDefinition Width="310"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="Titre" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="1" Text="Durée" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="2" Text="Date prévue" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="3" Text="Statut" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
								<TextBlock Grid.Column="4" Text="Actions" FontSize="11" FontWeight="600" Foreground="{DynamicResource MutedBrush}"/>
							</Grid>

							<Border Height="1" Background="{DynamicResource BgBrush}" Margin="0,0,0,4"
                                    Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}"/>

							<!-- Liste examens (page courante) -->
							<ItemsControl x:Name="ListeExamensItems"
                                          ItemsSource="{Binding ExamensPage}"
                                          Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="0,10" BorderBrush="{DynamicResource BgBrush}" BorderThickness="0,0,0,1">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="100"/>
													<ColumnDefinition Width="90"/>
													<ColumnDefinition Width="80"/>
													<ColumnDefinition Width="310"/>
												</Grid.ColumnDefinitions>

												<StackPanel Grid.Column="0" VerticalAlignment="Center">
													<TextBlock Text="{Binding TitreAffiche}" FontSize="13"
                                                               FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Cursor="Hand">
														<TextBlock.InputBindings>
															<MouseBinding MouseAction="LeftClick"
																		  Command="{Binding DataContext.OuvrirExamenCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
																		  CommandParameter="{Binding}"/>
														</TextBlock.InputBindings>
													</TextBlock>
													<TextBlock Text="{Binding CoursSourceAffiche}" FontSize="11"
                                                               Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
												</StackPanel>

												<TextBlock Grid.Column="1" FontSize="12"
                                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center">
													<Run Text="{Binding Examen.Duree}"/>
													<Run Text=" min"/>
												</TextBlock>

												<TextBlock Grid.Column="2" FontSize="12"
                                                           Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Examen.DatePrevue, StringFormat='{}{0:dd/MM/yy HH:mm}', TargetNullValue='Non définie'}"
                                                           ToolTip="{Binding Examen.DatePrevue, StringFormat='{}{0:dd/MM/yy HH:mm}'}"/>

												<!-- Badge statut -->
												<Border Grid.Column="3" CornerRadius="6" Padding="8,3"
                                                        VerticalAlignment="Center" HorizontalAlignment="Left">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="{DynamicResource WarnLightBgBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Examen.Statut}" Value="PUBLIE">
																	<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Examen.Statut}" Value="EN_COURS">
																	<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Examen.Statut}" Value="TERMINE">
																	<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock FontSize="10" FontWeight="700" Text="{Binding StatutAffiche}">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Examen.Statut}" Value="PUBLIE">
																		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Examen.Statut}" Value="EN_COURS">
																		<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Examen.Statut}" Value="TERMINE">
																		<Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>

												<!-- Actions (aligné sur la liste quiz : ActionBtn, marges 6, pas de ProgressBar) -->
												<StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
													<!-- Publier : visible seulement en brouillon non publié (ou pendant la publication) -->
													<Button Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource AccentLightBgBrush}"
                                                            Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                                            Visibility="{Binding PublierBoutonVisible, Converter={StaticResource BoolToVis}}"
                                                            IsEnabled="{Binding PublierBoutonActif}"
                                                            Command="{Binding DataContext.PublierExamenSurLeWebCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding IsPublicationEnCours}" Value="True">
																		<Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
																	</DataTrigger>
																	<Trigger Property="IsEnabled" Value="False">
																		<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
																		<Setter Property="Opacity" Value="0.7"/>
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<TextBlock Text="{Binding PublierBoutonTexte}"/>
													</Button>
													<!-- Synchroniser : tons proches du bouton « Code QR » du quiz -->
													<Button Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                            Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"
                                                            Visibility="{Binding SynchroniserBoutonVisible, Converter={StaticResource BoolToVis}}"
                                                            IsEnabled="{Binding SynchroniserBoutonActif}"
                                                            Command="{Binding DataContext.SynchroniserExamenSurLeWebCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding IsSynchronisationEnCours}" Value="True">
																		<Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding AfficheSuccesSynchronisationCourt}" Value="True">
																		<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
																	</DataTrigger>
																	<Trigger Property="IsEnabled" Value="False">
																		<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
																		<Setter Property="Opacity" Value="0.7"/>
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<TextBlock Text="{Binding SynchroniserBoutonTexte}"/>
													</Button>
													<Button Margin="0,0,6,0"
                                                            Visibility="{Binding LancerBoutonVisible, Converter={StaticResource BoolToVis}}"
                                                            IsEnabled="{Binding LancerBoutonActif}"
                                                            Command="{Binding DataContext.LancerExamenCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
																<Style.Triggers>
																	<Trigger Property="IsEnabled" Value="False">
																		<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
																		<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																		<Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
																		<Setter Property="Opacity" Value="0.7"/>
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<TextBlock Text="{Binding LancerBoutonTexte}"/>
													</Button>
													<Button Margin="0,0,6,0"
                                                            Visibility="{Binding SuperviserBoutonVisible, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.SuperviserExamenCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																<Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
															</Style>
														</Button.Style>
														<TextBlock Text="Superviser"/>
													</Button>
													<Button Margin="0,0,6,0"
                                                            Visibility="{Binding ResultatsBoutonVisible, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ResultatsExamenCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
																<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
																<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
																<Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
															</Style>
														</Button.Style>
														<TextBlock Text="Résultats"/>
													</Button>
													<Button Style="{StaticResource IconDeleteBtn}"
                                                            ToolTip="{Binding SupprimerBoutonToolTip}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            IsEnabled="{Binding SupprimerBoutonActif}"
                                                            Command="{Binding DataContext.SupprimerExamenCommand,
                                                                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
														<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                    Foreground="{DynamicResource DangerBrush}"/>
													</Button>
												</StackPanel>

											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<!-- Pagination examens -->
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                                        Visibility="{Binding AfficherListeExamens, Converter={StaticResource BoolToVis}}">
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="0,0,8,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding ExamenPagePrecedenteCommand}">
									<TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
								<TextBlock Text="{Binding LibellePaginationExamen}" VerticalAlignment="Center"
                                           FontSize="12" FontWeight="600" Foreground="{DynamicResource SubTextBrush}" Margin="8,0"/>
								<Button Style="{StaticResource PaginationArrowBtn}"
                                        Margin="8,0,0,0" MinWidth="23" Padding="2,1"
                                        Command="{Binding ExamenPageSuivanteCommand}">
									<TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
								</Button>
							</StackPanel>

							<!-- État vide examens -->
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoExamens, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun examen créé pour le moment"
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
							</StackPanel>
							<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                        Visibility="{Binding HasNoExamensRecherche, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="Aucun examen ne correspond à la recherche"
                                           FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
							</StackPanel>

						</StackPanel>
					</Border>

				</StackPanel>
			</ScrollViewer>

		</Grid>
	</Grid>
</Window>



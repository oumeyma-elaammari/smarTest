<Window x:Class="smartest_desktop.Views.ExamenSupervisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supervision — examen web"
        Width="520"
        MinWidth="480"
        Height="Auto"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Height"
        Background="#fafbfd"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="24,20" BorderBrush="#e2e8f4">
        <StackPanel>
            <TextBlock x:Name="TxtTitle"
                       FontSize="17" FontWeight="700" Foreground="{StaticResource NavyBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock FontSize="12" Foreground="#64748b" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Les étudiants sur le web reçoivent chaque action en temps réel (changement de question, pause, fin de session)."/>

            <Border Background="White" CornerRadius="12" BorderBrush="#e2e8f4" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="11" FontWeight="600" Foreground="#8899b8" Margin="0,0,0,6">État de la session</TextBlock>
                        <TextBlock x:Name="TxtEtat" FontSize="14" FontWeight="600" Foreground="#0f1e3d" Text="…"/>
                        <TextBlock x:Name="TxtQuestion" FontSize="13" Foreground="#475569" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtTemps" FontSize="12" Foreground="#64748b" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtErreur"
                               Grid.Column="1"
                               VerticalAlignment="Top"
                               FontSize="11"
                               Foreground="#b45309"
                               MaxWidth="180"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Background="#f8fafc" CornerRadius="12" BorderBrush="#e2e8f4" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#8899b8" Margin="0,0,0,6"
                               Text="Étudiants connectés (salle d’attente)"/>
                    <TextBlock x:Name="TxtSalleAttenteCount" FontSize="14" FontWeight="SemiBold" Foreground="#0f1e3d" Margin="0,0,0,8" Text="…"/>
                    <ListBox x:Name="ListAttente" MaxHeight="180" FontSize="12" BorderThickness="1" BorderBrush="#e2e8f4"
                             Background="White"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtApercu" FontSize="12" Foreground="#475569" TextWrapping="Wrap"
                       Margin="0,0,0,14" MaxHeight="120" TextTrimming="CharacterEllipsis"/>

            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="BtnDemarrer" Content="Démarrer l'examen" Margin="0,0,8,8" Padding="14,8"
                        Background="#0f1e3d" Foreground="White" BorderThickness="0" FontWeight="600" Cursor="Hand"
                        Click="BtnDemarrer_Click"/>
                <Button x:Name="BtnPause" Content="Mettre en pause" Margin="0,0,8,8" Padding="14,8"
                        Background="#fff7ed" Foreground="#9a3412" BorderBrush="#fed7aa" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnPause_Click"/>
                <Button x:Name="BtnReprendre" Content="Reprendre" Margin="0,0,8,8" Padding="14,8"
                        Background="#ecfdf5" Foreground="#047857" BorderBrush="#a7f3d0" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnReprendre_Click"/>
                <Button x:Name="BtnPrecedente" Content="Question précédente" Margin="0,0,8,8" Padding="14,8"
                        Background="#f8fafc" Foreground="#334155" BorderBrush="#e2e8f0" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnPrecedente_Click"/>
                <Button x:Name="BtnSuivante" Content="Question suivante" Margin="0,0,8,8" Padding="14,8"
                        Background="#eef3fd" Foreground="#1e40af" BorderBrush="#dbeafe" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnSuivante_Click"/>
                <Button x:Name="BtnTempsMoins" Content="Temps −5 min" Margin="0,0,8,8" Padding="14,8"
                        Background="#fff" Foreground="#475569" BorderBrush="#cbd5e1" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnTempsMoins_Click"/>
                <Button x:Name="BtnTempsPlus" Content="Temps +5 min" Margin="0,0,8,8" Padding="14,8"
                        Background="#fff" Foreground="#475569" BorderBrush="#cbd5e1" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnTempsPlus_Click"/>
                <Button x:Name="BtnTerminer" Content="Terminer l'examen" Margin="0,0,8,8" Padding="14,8"
                        Background="#fef2f2" Foreground="#b91c1c" BorderBrush="#fecaca" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnTerminer_Click"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Fermer" IsCancel="True" Padding="16,9"
                        Background="#f0f3f9" Foreground="#475569" BorderThickness="0" FontWeight="600" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="smartest_desktop.Views.ExamenSupervisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supervision — examen web"
        Width="520"
        MinWidth="480"
        Height="Auto"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Height"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Padding="24,20" BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel>
            <TextBlock x:Name="TxtTitle"
                       FontSize="17" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock FontSize="12" Foreground="{DynamicResource LabelBrush}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Les étudiants sur le web reçoivent chaque action en temps réel (changement de question, pause, fin de session)."/>

            <Border Background="{DynamicResource CardBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtQuestion" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtTemps" FontSize="12" Foreground="{DynamicResource LabelBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtErreur"
                               Grid.Column="1"
                               VerticalAlignment="Top"
                               FontSize="11"
                               Foreground="{DynamicResource WarnBrush}"
                               MaxWidth="180"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource BgBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtListeParticipantsTitre"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"
                               Text="Salle d’attente"/>
                    <TextBlock x:Name="TxtSalleAttenteCount" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NavyBrush}" Margin="0,0,0,8" Text="…"/>
                    <ListBox x:Name="ListAttente" MaxHeight="180" FontSize="12" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                             Background="{DynamicResource CardBgBrush}"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtApercu" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,14" MaxHeight="120" TextTrimming="CharacterEllipsis"/>

            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="BtnDemarrer" Content="Démarrer l'examen" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource NavyBrush}" Foreground="White" BorderThickness="0" FontWeight="600" Cursor="Hand"
                        Click="BtnDemarrer_Click"/>
                <Button x:Name="BtnPause" Content="Mettre en pause" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource WarnLightBgBrush}" Foreground="{DynamicResource WarnBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnPause_Click"/>
                <Button x:Name="BtnReprendre" Content="Reprendre" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource SuccessLightBgBrush}" Foreground="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnReprendre_Click"/>
                <Button x:Name="BtnPrecedente" Content="Question précédente" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource NavyBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnPrecedente_Click"/>
                <Button x:Name="BtnSuivante" Content="Question suivante" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource AccentLightBgBrush}" Foreground="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnSuivante_Click"/>
                <Button x:Name="BtnTempsMoins" Content="Temps question −30 s" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextTertiaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnTempsMoins_Click"/>
                <Button x:Name="BtnTempsPlus" Content="Temps question +30 s" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextTertiaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnTempsPlus_Click"/>
                <Button x:Name="BtnTerminer" Content="Terminer l'examen" Margin="0,0,8,8" Padding="14,8"
                        Background="{DynamicResource DangerZoneBgBrush}" Foreground="{DynamicResource DangerBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1" FontWeight="600" Cursor="Hand"
                        Click="BtnTerminer_Click"/>
            </WrapPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Fermer" IsCancel="True" Padding="16,9"
                        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextTertiaryBrush}" BorderThickness="0" FontWeight="600" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>


<Window x:Class="smartest_desktop.Views.ChoisirDateHeureLancementExamenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créneau de lancement — publication web"
        Height="Auto"
        Width="460"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Background="#fafbfd"
        FontFamily="Segoe UI">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Border Padding="28,22" BorderBrush="#e2e8f4" BorderThickness="0">
		<StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
				<Border Width="36" Height="36" CornerRadius="10" Background="#eef3fd" VerticalAlignment="Top" Margin="0,0,14,0">
					<TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
				<StackPanel>
					<TextBlock Text="Date et heure du passage"
                               FontSize="16" FontWeight="700" Foreground="{StaticResource NavyBrush}"/>
					<TextBlock Text="Ce créneau est visible aux étudiants sur le web avec la durée de l'épreuve."
                               FontSize="12" Foreground="#64748b" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"/>
				</StackPanel>
			</StackPanel>

			<Border Background="White" CornerRadius="12" BorderBrush="#e2e8f4" BorderThickness="1" Padding="16,14" Margin="0,0,0,12">
				<StackPanel>
					<TextBlock Text="Jour" FontSize="11" FontWeight="600" Foreground="#8899b8" Margin="0,0,0,6"/>
					<DatePicker x:Name="DpDate" FontSize="14" Padding="4,6"
                                BorderBrush="#e2e8f4"/>
				</StackPanel>
			</Border>

			<Border Background="White" CornerRadius="12" BorderBrush="#e2e8f4" BorderThickness="1" Padding="16,14" Margin="0,0,0,20">
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="Heure" FontSize="11" FontWeight="600" Foreground="#8899b8"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
					<ComboBox x:Name="CbHour" Width="76" Height="32" Padding="8,4" FontSize="13"
                              BorderBrush="#e2e8f4" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
					<TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="600" Foreground="{StaticResource NavyBrush}"/>
					<ComboBox x:Name="CbMinute" Width="76" Height="32" Padding="8,4" FontSize="13"
                              BorderBrush="#e2e8f4" VerticalContentAlignment="Center"/>
				</StackPanel>
			</Border>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Annuler" IsCancel="True"
                        Padding="14,10" Margin="0,0,10,0"
                        Background="#f0f3f9" Foreground="#475569" BorderThickness="0"
                        FontSize="13" FontWeight="600" Cursor="Hand" FontFamily="Segoe UI">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</ControlTemplate>
					</Button.Template>
				</Button>
				<Button Content="Valider" IsDefault="True" Click="Valider_Click"
                        Padding="18,10"
                        Background="{StaticResource NavyBrush}" Foreground="White" BorderThickness="0"
                        FontSize="13" FontWeight="600" Cursor="Hand" FontFamily="Segoe UI">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border x:Name="BdV" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="BdV" Property="Background" Value="{StaticResource NavyLightBrush}"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Button.Template>
				</Button>
			</StackPanel>
		</StackPanel>
	</Border>
</Window>

<Window x:Class="smartest_desktop.Views.QuizResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:smartest_desktop.ViewModels"
        xmlns:conv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="{Binding TitreFenetre}"
        Height="780" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="QRCard" TargetType="Border">
				<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
				<Setter Property="CornerRadius" Value="12"/>
				<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
			</Style>

			<!-- Valider le quiz : même couleur que le titre (#0f1e3d) -->
			<Style x:Key="QRValidateBorder" TargetType="Border">
				<Setter Property="CornerRadius" Value="9"/>
				<Setter Property="Padding" Value="18,11"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Background" Value="{DynamicResource PrimaryActionBgBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
						<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
					</Trigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="QRSecondaryBorder" TargetType="Border">
				<Setter Property="CornerRadius" Value="9"/>
				<Setter Property="Padding" Value="14,9"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="Background" Value="{DynamicResource BgBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
					</Trigger>
				</Style.Triggers>
			</Style>

			<!-- TextBox SANS bordure : intérieur des options A/B/C/D et champs arrondis -->
			<Style x:Key="QREditField" TargetType="TextBox">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Padding" Value="0"/>
				<Setter Property="FontSize" Value="12"/>
				<Setter Property="Foreground" Value="{DynamicResource NavyBrush}"/>
				<Setter Property="TextWrapping" Value="Wrap"/>
				<Setter Property="AcceptsReturn" Value="True"/>
				<Setter Property="CaretBrush" Value="{DynamicResource NavyBrush}"/>
			</Style>

			<conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ══ HEADER ══ -->
		<Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="28,16">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Retour -->
				<Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                        Background="{DynamicResource AccentLightBgBrush}" Cursor="Hand" Margin="0,0,20,0">
					<Border.InputBindings>
						<MouseBinding MouseAction="LeftClick" Command="{Binding RetourCommand}"/>
					</Border.InputBindings>
					<TextBlock Text="&#xE72B;" FontSize="14" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource NavyBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>

				<!-- Info quiz -->
				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal" Margin="0,0,0,3">
						<Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBox Text="{Binding TitreQuiz, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="320"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 FontSize="16"
                                 FontWeight="700"
                                 Foreground="{DynamicResource NavyBrush}"
                                 VerticalContentAlignment="Center"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal">
						<TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding SousTitreCompteur}"/>
						<TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
						<TextBlock Text="{Binding SousTitreEtape}"
                                   FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
					</StackPanel>
				</StackPanel>

				<!-- Actions header -->
				<StackPanel Grid.Column="2" Orientation="Horizontal">
					<!-- Regénérer (première génération uniquement) -->
					<Border Margin="0,0,10,0">
						<Border.Style>
							<Style TargetType="Border" BasedOn="{StaticResource QRSecondaryBorder}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsEditionQuizExistant}" Value="True">
										<Setter Property="Visibility" Value="Collapsed"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<Border.InputBindings>
							<MouseBinding MouseAction="LeftClick" Command="{Binding RegenerarCommand}"/>
						</Border.InputBindings>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
							<TextBlock Text="Regénérer" FontSize="12" FontWeight="500" Foreground="{DynamicResource SubTextBrush}"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>

					<!-- Valider -->
					<Border>
						<Border.Style>
							<Style TargetType="Border" BasedOn="{StaticResource QRValidateBorder}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsValidationEnCours}" Value="True">
										<Setter Property="Opacity" Value="0.7"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<Border.InputBindings>
							<MouseBinding MouseAction="LeftClick" Command="{Binding ValiderQuizCommand}"/>
						</Border.InputBindings>
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource PrimaryActionFgBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
							<TextBlock Text="{Binding LibelleBoutonValider}" FontSize="12" FontWeight="700" Foreground="{DynamicResource PrimaryActionFgBrush}"
                                       VerticalAlignment="Center"/>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENU ══ -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="380"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ══ LISTE DES QUESTIONS ══ -->
			<Border Grid.Column="0" Background="{DynamicResource WindowBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Border Grid.Row="0" Padding="20,18,20,14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
						<StackPanel>
							<TextBlock Text="Questions du quiz" FontSize="14" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
							<TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
									   Text="{Binding SousTitreQuestionsListe}"/>
							<Button Margin="0,14,0,0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,9" Cursor="Hand"
                                    Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Command="{Binding AjouterQuestionCommand}"
                                    FocusVisualStyle="{x:Null}">
								<Button.Style>
									<Style TargetType="Button">
										<Setter Property="IsEnabled" Value="True"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding QuestionsVerrouilleesParPublication}" Value="True">
												<Setter Property="IsEnabled" Value="False"/>
												<Setter Property="Opacity" Value="0.5"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Button.Style>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource NavyBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBlock Text="Ajouter une question" FontSize="12" FontWeight="600" Foreground="{DynamicResource SubTextBrush}"
                                               VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

							<!-- Liste étudiants : bascule panneau droit (reste visible même quand le panneau droit affiche la liste) -->
							<Button Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="14,9" Cursor="Hand"
                                    Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    Command="{Binding VoirListeEtudiantsCommand}"
                                    FocusVisualStyle="{x:Null}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
									<TextBlock Text="Liste des étudiants" FontSize="12" FontWeight="600" Foreground="{DynamicResource InputFocusBorderBrush}"
                                               VerticalAlignment="Center"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
						<StackPanel>
						<ItemsControl ItemsSource="{Binding Questions}" Margin="12,12,12,12">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Margin="0,0,0,8" Cursor="Hand" CornerRadius="10"
                                            BorderThickness="1.5" Padding="14,12">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectionnerQuestionCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource BgBrush}"/>
														<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
													</Trigger>
													<DataTrigger Binding="{Binding IsSelected}" Value="True">
														<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
														<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<!-- Numéro -->
											<Border Grid.Column="0" Width="30" Height="30"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource AccentLightBgBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0" VerticalAlignment="Top">
												<TextBlock Text="{Binding Numero}" FontSize="11"
                                                           FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
											</Border>

											<!-- Énoncé (pas de réponse dans la liste) -->
											<StackPanel Grid.Column="1" VerticalAlignment="Top">
												<TextBlock Text="{Binding Enonce}" FontSize="11"
                                                           Foreground="{DynamicResource NavyBrush}" TextWrapping="Wrap"
                                                           FontWeight="500" MaxHeight="48"
                                                           TextTrimming="CharacterEllipsis"/>
											</StackPanel>

											<!-- Supprimer -->
											<Border Grid.Column="2" Width="26" Height="26"
                                                    CornerRadius="7" Cursor="Hand"
                                                    VerticalAlignment="Top" Margin="6,0,0,0"
                                                    ToolTip="Supprimer cette question">
												<Border.InputBindings>
													<MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SupprimerQuestionCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"/>
												</Border.InputBindings>
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Background" Value="Transparent"/>
														<Style.Triggers>
															<Trigger Property="IsMouseOver" Value="True">
																<Setter Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
															</Trigger>
															<DataTrigger Binding="{Binding DataContext.QuestionsVerrouilleesParPublication, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
																<Setter Property="Visibility" Value="Collapsed"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
											</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						</StackPanel>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- ══ DÉTAIL / ÉDITION ══ -->
			<Grid Grid.Column="1" Background="{DynamicResource WindowBgBrush}">

				<!-- Aucune question sélectionnée (pan droit — mode questions) -->
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding AfficherEtatSansQuestion, Converter={StaticResource BoolToVis}}">
					<TextBlock Text="&#xE762;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="{DynamicResource CardBorderBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
					<TextBlock Text="Sélectionnez une question" FontSize="15" FontWeight="600"
                               Foreground="{DynamicResource NavyBrush}" HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding SousTitreSelectionQuestion}"
                               FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" Margin="0,8,0,0"/>
				</StackPanel>

				<!-- Publication web (même présentation qu’en colonne gauche avant déplacement) -->
				<ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding AfficherListeEtudiantsDroite, Converter={StaticResource BoolToVis}}">
					<StackPanel>
						<Border Margin="12,12,12,16" Padding="14,12" CornerRadius="10"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
							<StackPanel>
								<TextBlock Text="Publication vers la plateforme web" FontSize="13" FontWeight="700" Foreground="{DynamicResource NavyBrush}"  Margin="0,0,0,8"/>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
									<Border CornerRadius="8" Padding="12,8" Margin="0,0,8,0" Cursor="Hand">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding ImporterEmailsWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
												<Setter Property="BorderThickness" Value="1"/>
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
														<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="Importer fichier" FontSize="11" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"/>
									</Border>
									<Border CornerRadius="8" Padding="12,8" Cursor="Hand"
                                            Background="{DynamicResource DangerZoneBgBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1"
                                            ToolTip="Effacer la liste">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding EffacerEmailsWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
								<TextBlock Text="{Binding LibelleEmailsPublicationWeb}" FontSize="10" Foreground="{DynamicResource LabelBrush}"
                                           Margin="0,0,0,10"/>
								<TextBlock Text="Ajouter un email" FontSize="10" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,4"/>
								<Grid Margin="0,0,0,12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="8"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Border Grid.Column="0" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Background="{DynamicResource InputBgBrush}" Padding="8,4">
										<TextBox Text="{Binding NouvelEmailWeb, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Foreground="{DynamicResource NavyBrush}" BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"
                                                 ToolTip="Saisissez une adresse puis cliquez sur Ajouter"/>
									</Border>
									<Border Grid.Column="2" CornerRadius="8" Padding="12,8" Cursor="Hand"
                                            VerticalAlignment="Center">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding AjouterEmailUnitaireWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
												<Setter Property="BorderThickness" Value="1"/>
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
														<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="Ajouter" FontSize="11" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"/>
									</Border>
								</Grid>
								<Grid Margin="0,0,0,6">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0" Text="Liste des emails" FontSize="10" FontWeight="700" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
									<Border Grid.Column="1" Width="28" Height="28" CornerRadius="7" Cursor="Hand"
                                            Background="{DynamicResource DangerZoneBgBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1"
                                            ToolTip="Supprimer les emails sélectionnés"
                                            Visibility="{Binding AEmailsSelectionnes, Converter={StaticResource BoolToVis}}">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding SupprimerEmailsSelectionnesWebCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</Grid>
								<TextBlock Text="Aucun email pour l'instant. Importez un fichier ou ajoutez une adresse ci-dessus."
                                           FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding AucunEmailListeApercu, Converter={StaticResource BoolToVis}}"/>
								<ItemsControl ItemsSource="{Binding EmailsListeApercu}" Margin="0,0,0,0">
									<ItemsControl.Style>
										<Style TargetType="ItemsControl">
											<Setter Property="Visibility" Value="Visible"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding AucunEmailListeApercu}" Value="True">
													<Setter Property="Visibility" Value="Collapsed"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</ItemsControl.Style>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,0,0,4" Padding="8,6" CornerRadius="6" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
												<StackPanel Orientation="Horizontal">
													<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
													<TextBox Text="{Binding Email, Mode=TwoWay}" FontSize="11" Foreground="{DynamicResource NavyBrush}" FontFamily="Consolas" VerticalAlignment="Center"
                                                             BorderThickness="0" Background="Transparent" MinWidth="220"
                                                             ToolTip="Email modifiable"/>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>

				<!-- Question sélectionnée -->
				<ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding AfficherDetailQuestion, Converter={StaticResource BoolToVis}}">
					<Grid Margin="32,28,32,28" DataContext="{Binding QuestionSelectionnee}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>

						<!-- Header -->
						<StackPanel Grid.Row="0" Margin="0,0,0,20">
							<TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="600"
                                       Text="{Binding Numero, StringFormat='QUESTION {0}'}"/>
							<TextBlock Text="Détail de la question "
                                       FontSize="15" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,4,0,0"/>
						</StackPanel>

						<!-- Énoncé -->
						<Border Grid.Row="1" Style="{StaticResource QRCard}" Padding="20,16" Margin="0,0,0,16">
							<StackPanel>
								<TextBlock Text="ÉNONCÉ" FontSize="10" FontWeight="700"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
								<!-- Border arrondi qui entoure le TextBox -->
								<Border CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Background="{DynamicResource InputBgBrush}">
									<TextBox Style="{StaticResource QREditField}"
                                             Padding="10,8"
                                             Text="{Binding Enonce, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="60"
                                             IsReadOnly="{Binding DataContext.QuestionsVerrouilleesParPublication, RelativeSource={RelativeSource AncestorType=Window}}"/>
								</Border>
							</StackPanel>
						</Border>

						<!-- Options A B C D -->
						<Border Grid.Row="2" Style="{StaticResource QRCard}" Padding="20,16" Margin="0,0,0,16">
							<StackPanel>
								<TextBlock Text="OPTIONS" FontSize="10" FontWeight="700"
                                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="12"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="10"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<!-- Option A -->

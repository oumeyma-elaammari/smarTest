<Window x:Class="smartest_desktop.Views.ExamenCopiesEnAttenteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copies à corriger"
        Width="520"
        MinWidth="460"
        Height="480"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24,20" BorderBrush="{DynamicResource CardBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TxtTitre" FontSize="17" FontWeight="700" Foreground="{DynamicResource NavyBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="Sélectionnez un étudiant pour voir ses réponses et valider les notes."
                           FontSize="12" Foreground="{DynamicResource LabelBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock x:Name="TxtErreur" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6">
                <Grid>
                    <TextBlock x:Name="TxtVide" Text="Aucune copie en attente pour cet examen."
                               FontSize="13" Foreground="{DynamicResource LabelBrush}" Margin="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtChargement" Text="Chargement…" FontSize="13" Foreground="{DynamicResource LabelBrush}"
                               Margin="12" VerticalAlignment="Center"/>
                    <ListBox x:Name="ListeEtudiants" BorderThickness="0" Background="Transparent"
                             DisplayMemberPath="Libelle"
                             MouseDoubleClick="ListeEtudiants_MouseDoubleClick"
                             Visibility="Collapsed">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Fermer" Padding="14,8" Margin="0,0,8,0" IsCancel="True"
                        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextTertiaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        FontWeight="600" Cursor="Hand" Click="BtnFermer_Click"/>
                <Button Content="Ouvrir la correction" Padding="14,8" IsDefault="True"
                        Style="{StaticResource PrimaryBtn}" Click="BtnOuvrirCorrection_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>


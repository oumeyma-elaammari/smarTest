<Window x:Class="smartest_desktop.Views.SuppressionCompteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supprimer le compte"
        Icon="/Assets/SmarTest-AppIcon.png"
        Width="480"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24,20" BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel>
            <TextBlock Text="Êtes-vous sûr ?"
                       FontSize="17" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Cette action supprimera définitivement votre compte ET toutes vos données locales (cours, questions, quiz, examens)."
                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                       TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" MinWidth="100" Height="36" Padding="14,0" Margin="0,0,10,0"
                        Background="{DynamicResource SecondaryBtnBgBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        BorderBrush="{DynamicResource SecondaryBtnBorderBrush}" BorderThickness="1"
                        FontWeight="SemiBold" Cursor="Hand" Click="BtnAnnuler_Click"/>
                <Button Content="Supprimer définitivement" MinWidth="180" Height="36" Padding="14,0" IsDefault="True"
                        Background="{DynamicResource DangerBrush}" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnConfirmer_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

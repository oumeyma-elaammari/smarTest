<UserControl x:Class="smartest_desktop.Views.StatistiquesDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             Background="Transparent">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="ExportBtnWhite" TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NavyBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatsComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBgBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{DynamicResource InputBgBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SelectionBoxItem.LibelleListe, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           FontWeight="SemiBold"
                                                           Margin="4,0,8,0"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="⌄" FontSize="12"
                                                           Foreground="{DynamicResource SubTextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="Statistiques et résultats" FontSize="24" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
        </StackPanel>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        </Grid>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="1" Style="{StaticResource StatsComboBox}" MinWidth="300" VerticalAlignment="Center" Padding="10,7"
                      ItemsSource="{Binding EvaluationsItems}"
                      SelectedItem="{Binding EvaluationChoisi, Mode=TwoWay}"
                      DisplayMemberPath="LibelleListe"/>
        </Grid>

        <TextBlock Text="Chargement…" Foreground="{DynamicResource LabelBrush}" FontSize="13" Margin="0,0,0,4"
                   Visibility="{Binding Chargement, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="{Binding Erreur}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,4">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Chargement}" Value="False"/>
                                <Condition Binding="{Binding AErreur}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Visibility="{Binding DonneesChargees, Converter={StaticResource BoolToVis}}">
            <!-- Alerte : questions à risque -->
            <Border Margin="0,0,0,16" Padding="14,12" CornerRadius="8"
                    BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource DangerZoneBgBrush}"
                    Visibility="{Binding AfficherAlerteQuestionsRisque, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Questions à risque détectées" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DangerZoneTitleBrush}"/>
                        <TextBlock Text="{Binding AlerteQuestionsRisqueDetail}" FontSize="12" Foreground="{DynamicResource DangerZoneTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="0,8,0,20">
                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentLightBgBrush}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Moyenne générale" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding MoyenneGeneraleSur20}" FontSize="20" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="5,0,5,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentLightBgBrush}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Taux de réussite" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding TauxReussiteGlobalLibelle}" FontSize="20" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentLightBgBrush}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Nombre d'étudiants" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding NombreEtudiants}" FontSize="20" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0" MinHeight="330">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Distribution des notes" FontSize="14" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,0,0,12"/>
                        <Grid Grid.Row="1" MinHeight="220">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding BarresHistogramme}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="50" Margin="0,0,10,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="250"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Height="250" VerticalAlignment="Bottom">
                                                    <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="50"
                                                            CornerRadius="4,4,0,0" Background="{DynamicResource ActiveMenuBgBrush}"/>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Width="50"
                                                            CornerRadius="4,4,0,0"
                                                            Background="{DynamicResource NavyBrush}"
                                                            Height="{Binding HauteurBarrePx}" MinHeight="0"/>
                                                    <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource CardBorderBrush}" HorizontalAlignment="Stretch"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Effectif}" FontSize="12" FontWeight="600" Foreground="{DynamicResource LabelBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,2"/>
                                                <TextBlock Grid.Row="2" Text="{Binding LabelTranche}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="10,0,0,0" MinHeight="430">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                        <TextBlock Text="Taux de réussite par question" FontSize="14" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                                   Width="472" TextAlignment="Left" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8" Width="472">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="1" Width="360">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="0" FontSize="11" Foreground="{DynamicResource LabelBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="25" FontSize="11" Foreground="{DynamicResource LabelBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="50" FontSize="11" Foreground="{DynamicResource LabelBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="75" FontSize="11" Foreground="{DynamicResource LabelBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="100" FontSize="11" Foreground="{DynamicResource LabelBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                        <ScrollViewer Width="472" Height="330" VerticalAlignment="Top"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding BarresQuestionReussite}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="360"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding LibelleQuestion}" FontWeight="600" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="360" Height="26" Background="{DynamicResource ActiveMenuBgBrush}" CornerRadius="5" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" CornerRadius="5" Height="26"
                                                        Width="{Binding LargeurBarrePx}"
                                                        Background="{Binding CouleurBarreReussite}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource NavyBrush}" FontWeight="500" Margin="0,0,5,0">
                                                <TextBlock.Text>
                                                    <Binding Path="PourcentageReussite" StringFormat="{}{0:F0}%"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                                                       Visibility="{Binding AfficherAlerte, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="Taux d'échec supérieur à 40 % sur cette question"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Export sous les graphiques -->
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Style="{StaticResource ExportBtnWhite}" Margin="0,0,10,0"
                        Command="{Binding ExporterCsvCommand}" IsEnabled="{Binding PeutExporter}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Exporter CSV" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ExportBtnWhite}"
                        Command="{Binding ExporterPdfCommand}" IsEnabled="{Binding PeutExporter}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Exporter PDF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>

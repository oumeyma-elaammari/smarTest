<UserControl x:Class="smartest_desktop.Views.StatistiquesDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             Background="Transparent">
	<UserControl.Resources>
		<conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
		<!-- Palette maquette : histogramme #1A237E, réussite verte #2E7D32 / rouge #C62828 -->
		<SolidColorBrush x:Key="HistBarreBrush" Color="#1A237E"/>

		<Style x:Key="StatCard" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="BorderBrush" Value="#e2e8f4"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="16,14"/>
		</Style>
		<Style x:Key="ExportBtnWhite" TargetType="Button">
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Foreground" Value="#0f1e3d"/>
			<Setter Property="BorderBrush" Value="#d1d5db"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="6" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<StackPanel>
		<StackPanel Margin="0,0,0,8">
			<TextBlock Text="Statistiques et résultats" FontSize="24" FontWeight="700" Foreground="#0f1e3d"/>
		</StackPanel>

		<Grid Margin="0,0,0,12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
		</Grid>
		<Grid Margin="0,0,0,14">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<ComboBox Grid.Column="1" MinWidth="300" VerticalAlignment="Center" Padding="8,6"
					  ItemsSource="{Binding EvaluationsItems}"
					  SelectedItem="{Binding EvaluationChoisi, Mode=TwoWay}"
					  DisplayMemberPath="LibelleListe"/>
		</Grid>

		<TextBlock Text="Chargement…" Foreground="#64748b" FontSize="13" Margin="0,0,0,4"
				   Visibility="{Binding Chargement, Converter={StaticResource BoolToVis}}"/>
		<TextBlock Text="{Binding Erreur}" Foreground="#b91c1c" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,4">
			<TextBlock.Style>
				<Style TargetType="TextBlock">
					<Setter Property="Visibility" Value="Collapsed"/>
					<Style.Triggers>
						<MultiDataTrigger>
							<MultiDataTrigger.Conditions>
								<Condition Binding="{Binding Chargement}" Value="False"/>
								<Condition Binding="{Binding AErreur}" Value="True"/>
							</MultiDataTrigger.Conditions>
							<Setter Property="Visibility" Value="Visible"/>
						</MultiDataTrigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>

		<StackPanel Visibility="{Binding DonneesChargees, Converter={StaticResource BoolToVis}}">
			<!-- Alerte : rouge faible -->
			<Border Margin="0,0,0,16" Padding="14,12" CornerRadius="8"
					BorderBrush="#fecaca" BorderThickness="1" Background="#fef2f2"
					Visibility="{Binding AfficherAlerteQuestionsRisque, Converter={StaticResource BoolToVis}}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Column="0" Text="&#xE814;" FontFamily="Segoe MDL2 Assets" FontSize="18"
							   Foreground="#f87171" VerticalAlignment="Top" Margin="0,2,12,0"/>
					<StackPanel Grid.Column="1">
						<TextBlock Text="Questions à risque détectées" FontWeight="Bold" FontSize="13" Foreground="#b91c1c"/>
						<TextBlock Text="{Binding AlerteQuestionsRisqueDetail}" FontSize="12" Foreground="#991b1b"
								   TextWrapping="Wrap" Margin="0,4,0,0"/>
					</StackPanel>
				</Grid>
			</Border>
			<UniformGrid Columns="3" Margin="0,8,0,20">
				<Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
					<StackPanel Orientation="Horizontal">
						<Border Width="36" Height="36" CornerRadius="18" Background="#eef3fd" VerticalAlignment="Top" Margin="0,0,12,0">
							<TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#1A237E"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel>
							<TextBlock Text="Moyenne générale" FontSize="11" Foreground="#8899b8"/>
							<TextBlock Text="{Binding MoyenneGeneraleSur20}" FontSize="20" FontWeight="700" Foreground="#0f1e3d"/>
						</StackPanel>
					</StackPanel>
				</Border>
				<Border Style="{StaticResource StatCard}" Margin="5,0,5,0">
					<StackPanel Orientation="Horizontal">
						<Border Width="36" Height="36" CornerRadius="18" Background="#eef3fd" VerticalAlignment="Top" Margin="0,0,12,0">
							<TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#1A237E"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel>
							<TextBlock Text="Taux de réussite" FontSize="11" Foreground="#8899b8"/>
							<TextBlock Text="{Binding TauxReussiteGlobalLibelle}" FontSize="20" FontWeight="700" Foreground="#0f1e3d"/>
						</StackPanel>
					</StackPanel>
				</Border>
				<Border Style="{StaticResource StatCard}" Margin="10,0,0,0">
					<StackPanel Orientation="Horizontal">
						<Border Width="36" Height="36" CornerRadius="18" Background="#eef3fd" VerticalAlignment="Top" Margin="0,0,12,0">
							<TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#1A237E"
									   HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<StackPanel>
							<TextBlock Text="Nombre d'étudiants" FontSize="11" Foreground="#8899b8"/>
							<TextBlock Text="{Binding NombreEtudiants}" FontSize="20" FontWeight="700" Foreground="#0f1e3d"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</UniformGrid>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Style="{StaticResource StatCard}" Margin="0,0,10,0" MinHeight="330">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<TextBlock Grid.Row="0" Text="Distribution des notes" FontSize="14" FontWeight="700" Foreground="#0f1e3d" Margin="0,0,0,12"/>
						<Grid Grid.Row="1" MinHeight="220">
							<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
								<ItemsControl ItemsSource="{Binding BarresHistogramme}" HorizontalAlignment="Center">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<!-- Hauteur de barre = effectif / max ; pas de pilier gris pleine hauteur (sinon 0 et max paraissent identiques) -->
											<Grid Width="50" Margin="0,0,10,0">
												<Grid.RowDefinitions>
													<RowDefinition Height="250"/>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="Auto"/>
												</Grid.RowDefinitions>
												<Grid Grid.Row="0" Height="250" VerticalAlignment="Bottom">
													<!-- Piste grise pleine hauteur ; remplissage marine = part relative à l’effectif max -->
													<Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="50"
															CornerRadius="4,4,0,0" Background="#e8eef8"/>
													<Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Width="50"
															CornerRadius="4,4,0,0"
															Background="{StaticResource HistBarreBrush}"
															Height="{Binding HauteurBarrePx}" MinHeight="0"/>
													<Border VerticalAlignment="Bottom" Height="1" Background="#cbd5e1" HorizontalAlignment="Stretch"/>
												</Grid>
												<TextBlock Grid.Row="1" Text="{Binding Effectif}" FontSize="12" FontWeight="600" Foreground="#64748b"
														   HorizontalAlignment="Center" Margin="0,6,0,2"/>
												<TextBlock Grid.Row="2" Text="{Binding LabelTranche}" FontSize="11" Foreground="#94a3b8"
														   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>

				<!-- Largeur contenu = 36 + 360 (PisteBarrePx) + 48 + 28 ; centré dans la carte -->
				<Border Grid.Column="1" Style="{StaticResource StatCard}" Margin="10,0,0,0" MinHeight="430">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
						<!-- Même largeur que le bloc échelle + barres ; titre aligné à gauche dans ce bloc -->
						<TextBlock Text="Taux de réussite par question" FontSize="14" FontWeight="700" Foreground="#0f1e3d"
								   Width="472" TextAlignment="Left" Margin="0,0,0,8"/>
						<!-- Échelle 0–100 % : alignée sur la colonne des barres -->
						<Grid Margin="0,0,0,8" Width="472">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36"/>
								<ColumnDefinition Width="360"/>
								<ColumnDefinition Width="48"/>
								<ColumnDefinition Width="28"/>
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="1" Width="360">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<TextBlock Grid.Column="0" Text="0" FontSize="11" Foreground="#64748b" HorizontalAlignment="Left"/>
								<TextBlock Grid.Column="1" Text="25" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="2" Text="50" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="3" Text="75" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center"/>
								<TextBlock Grid.Column="4" Text="100" FontSize="11" Foreground="#64748b" HorizontalAlignment="Right"/>
							</Grid>
						</Grid>
						<!-- Vue fixes 330 px de hauteur ; liste des questions défile à l’intérieur -->
						<ScrollViewer Width="472" Height="330" VerticalAlignment="Top"
									  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
							<ItemsControl ItemsSource="{Binding BarresQuestionReussite}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid Margin="0,0,0,14">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="36"/>
												<ColumnDefinition Width="360"/>
												<ColumnDefinition Width="48"/>
												<ColumnDefinition Width="28"/>
											</Grid.ColumnDefinitions>
											<TextBlock Grid.Column="0" Text="{Binding LibelleQuestion}" FontWeight="600" Foreground="#0f1e3d" VerticalAlignment="Center"/>
											<Border Grid.Column="1" Width="360" Height="26" Background="#e8eef8" CornerRadius="5" Margin="0,0,6,0" VerticalAlignment="Center">
												<Border HorizontalAlignment="Left" CornerRadius="5" Height="26"
														Width="{Binding LargeurBarrePx}"
														Background="{Binding CouleurBarreReussite}"/>
											</Border>
											<TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#334155" FontWeight="500">
												<TextBlock.Text>
													<Binding Path="PourcentageReussite" StringFormat="{}{0:F0}%"/>
												</TextBlock.Text>
											</TextBlock>
											<TextBlock Grid.Column="3" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#f87171" VerticalAlignment="Center"
													   Visibility="{Binding AfficherAlerte, Converter={StaticResource BoolToVis}}"
													   ToolTip="Taux d'échec supérieur à 40 % sur cette question"/>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
				</Border>
			</Grid>

			<!-- Export sous les graphiques -->
			<StackPanel Orientation="Horizontal" Margin="0,24,0,0">
				<Button Style="{StaticResource ExportBtnWhite}" Margin="0,0,10,0"
						Command="{Binding ExporterCsvCommand}" IsEnabled="{Binding PeutExporter}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock Text="Exporter CSV" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
				<Button Style="{StaticResource ExportBtnWhite}"
						Command="{Binding ExporterPdfCommand}" IsEnabled="{Binding PeutExporter}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
						<TextBlock Text="Exporter PDF" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</StackPanel>
	</StackPanel>
</UserControl>

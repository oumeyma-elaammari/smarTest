<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Texte principal (contraste optimal pour lisibilité) ═══════════════════ -->
    <SolidColorBrush x:Key="NavyBrush"          Color="#E8EDF5"/>
    <SolidColorBrush x:Key="NavyLightBrush"     Color="#D1D9E8"/>
    <SolidColorBrush x:Key="AccentBrush"        Color="#7EA6E6"/>
    <SolidColorBrush x:Key="TextBrush"          Color="#E8EDF5"/>
    <SolidColorBrush x:Key="LabelBrush"         Color="#A0AAB8"/>
    <SolidColorBrush x:Key="SubTextBrush"       Color="#8A95A5"/>
    <SolidColorBrush x:Key="MutedBrush"         Color="#6E7A8A"/>
    <SolidColorBrush x:Key="FooterBrush"        Color="#6E7A8A"/>
    <SolidColorBrush x:Key="TextTertiaryBrush"  Color="#8A95A5"/>
    <SolidColorBrush x:Key="ContentTextBrush"   Color="#E8EDF5"/>
    <SolidColorBrush x:Key="GrayTextBrush"      Color="#8A95A5"/>
    <SolidColorBrush x:Key="DangerBrush"        Color="#E18686"/>
    <SolidColorBrush x:Key="SuccessBrush"       Color="#7BC58E"/>
    <SolidColorBrush x:Key="SuccessGreenBrush"  Color="#7BC58E"/>
    <SolidColorBrush x:Key="AccentTextBrush"    Color="#A8C5EF"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#A69BE6"/>
    <SolidColorBrush x:Key="WarnBrush"          Color="#D8A84F"/>
    <SolidColorBrush x:Key="PrimaryActionBgBrush" Color="#223047"/>
    <SolidColorBrush x:Key="PrimaryActionFgBrush" Color="#A8C5EF"/>

    <!-- ══ Arrière-plans (gamme de gris bleutés sans noir pur) ═══════════════════ -->
    <SolidColorBrush x:Key="BgBrush"            Color="#121820"/>
    <SolidColorBrush x:Key="BgSubBrush"         Color="#18222C"/>
    <SolidColorBrush x:Key="WindowBgBrush"      Color="#161E26"/>
    <SolidColorBrush x:Key="CardBgBrush"        Color="#1A2530"/>
    <SolidColorBrush x:Key="CardBorderBrush"    Color="#25323E"/>
    <SolidColorBrush x:Key="ContentBgBrush"     Color="#1A2530"/>
    <SolidColorBrush x:Key="ContentBorderBrush" Color="#25323E"/>
    <SolidColorBrush x:Key="SidebarBgBrush"     Color="#121820"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#25323E"/>
    <SolidColorBrush x:Key="InputBgBrush"       Color="#18222C"/>
    <SolidColorBrush x:Key="InputBorderBrush"   Color="#2C3A48"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#7EA6E6"/>
    <SolidColorBrush x:Key="SecondaryBtnBgBrush"     Color="#202832"/>
    <SolidColorBrush x:Key="SecondaryBtnBorderBrush" Color="#33404C"/>
    <SolidColorBrush x:Key="MenuHoverBgBrush"   Color="#202A34"/>
    <SolidColorBrush x:Key="ActiveMenuBgBrush"  Color="#223047"/>
    <SolidColorBrush x:Key="IconRingBgBrush"    Color="#223047"/>
    <SolidColorBrush x:Key="AccentLightBgBrush" Color="#223047"/>
    <SolidColorBrush x:Key="ActivityItemBgBrush" Color="#1A2530"/>
    <SolidColorBrush x:Key="SeparatorBrush"     Color="#25323E"/>
    <SolidColorBrush x:Key="FooterBarBgBrush"   Color="#161E26"/>
    <SolidColorBrush x:Key="FooterBarBorderBrush" Color="#25323E"/>
    <SolidColorBrush x:Key="UserInfoBgBrush"    Color="#1A2530"/>
    <SolidColorBrush x:Key="UserInfoBorderBrush" Color="#25323E"/>
    <SolidColorBrush x:Key="PageLabelBgBrush"   Color="#1A2530"/>
    <SolidColorBrush x:Key="WhiteBrush"         Color="#1A2530"/>

    <!-- ══ Alertes (contraste réduit pour moins de fatigue) ════════════════════ -->
    <SolidColorBrush x:Key="AlertErrorBgBrush"     Color="#2A2020"/>
    <SolidColorBrush x:Key="AlertErrorBorderBrush" Color="#5C3D3D"/>
    <SolidColorBrush x:Key="AlertErrorFgBrush"     Color="#E4AAAA"/>
    <SolidColorBrush x:Key="AlertSuccessBgBrush"     Color="#1C2822"/>
    <SolidColorBrush x:Key="AlertSuccessBorderBrush" Color="#3A5A43"/>
    <SolidColorBrush x:Key="AlertSuccessFgBrush"     Color="#A1D3AE"/>

    <!-- ══ Zone sensible (adoucie mais visible) ════════════════════════════════ -->
    <SolidColorBrush x:Key="DangerZoneBgBrush"     Color="#2A2020"/>
    <SolidColorBrush x:Key="DangerZoneBorderBrush" Color="#5C3D3D"/>
    <SolidColorBrush x:Key="DangerZoneTitleBrush"  Color="#E4AAAA"/>
    <SolidColorBrush x:Key="DangerZoneTextBrush"   Color="#CFA0A0"/>

    <!-- ══ Bouton déconnexion hover (visible sans agressivité) ══════════════════ -->
    <SolidColorBrush x:Key="LogoutHoverBgBrush"     Color="#2A2020"/>
    <SolidColorBrush x:Key="LogoutHoverBorderBrush" Color="#5C3D3D"/>

    <!-- ══ Statuts spéciaux (fondus et harmonisés) ══════════════════════════════ -->
    <SolidColorBrush x:Key="SuccessLightBgBrush"  Color="#1C2822"/>
    <SolidColorBrush x:Key="PurpleLightBgBrush"   Color="#2A2838"/>
    <SolidColorBrush x:Key="WarnLightBgBrush"     Color="#30271C"/>
    <SolidColorBrush x:Key="AvatarBgBrush"        Color="#2A2838"/>
    <SolidColorBrush x:Key="AvatarFgBrush"        Color="#B5ACEA"/>
    <SolidColorBrush x:Key="AnswerBgBrush"        Color="#1A2530"/>
    <SolidColorBrush x:Key="AnswerFgBrush"        Color="#8A95A5"/>

</ResourceDictionary>
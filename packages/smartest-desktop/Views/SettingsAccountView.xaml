<UserControl x:Class="smartest_desktop.Views.SettingsAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FlowDirection="LeftToRight"
             Language="en-US">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="SettingsSaveBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Background" Value="{DynamicResource PrimaryActionBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryActionFgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsDangerBtn" TargetType="Button">
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="{DynamicResource DangerZoneBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DangerZoneBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AlertErrorBgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer FlowDirection="LeftToRight"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Padding="0,0,4,16">
        <StackPanel FlowDirection="LeftToRight">
            <TextBlock Text="Paramètres" FontSize="24" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,0,0,18"/>

            <!-- ══ Profil ══════════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18" Width="860" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource NavyBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Profil" FontSize="16" FontWeight="700" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Nom complet" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6" Margin="0,0,0,12">
                        <TextBox Text="{Binding CompteNom, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"/>
                    </Border>

                    <TextBlock Text="Email" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6" Margin="0,0,0,14">
                        <TextBlock Text="{Binding CompteEmail}" FontSize="13" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SettingsSaveBtn}" Width="150" HorizontalAlignment="Left"
                                Command="{Binding EnregistrerCommand}" Content="Enregistrer"
                                Visibility="{Binding HasCompteChanges, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding MessageCompte}" Foreground="{Binding MessageCompteBrush}" FontSize="12" Margin="0,12,0,0"
                               Visibility="{Binding HasMessageCompte, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ══ Clé API Groq ══════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18" Width="860" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource NavyBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Clé API Groq" FontSize="16" FontWeight="700" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
                    </StackPanel>


                    <TextBlock Text="Clé API (commence par gsk_)" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10" FlowDirection="LeftToRight">
                        <Border x:Name="GroqKeyMaskedBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6">
                            <PasswordBox x:Name="GroqPasswordBox" PasswordChanged="GroqPasswordBox_PasswordChanged"
                                         IsEnabled="{Binding IsEditingGroqKey}"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                         FlowDirection="LeftToRight" Language="en-US"
                                         HorizontalContentAlignment="Left"/>
                        </Border>
                        <Border x:Name="GroqKeyPlainBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6" Visibility="Collapsed">
                            <TextBox x:Name="GroqTextBox" TextChanged="GroqTextBox_OnTextChanged"
                                     IsEnabled="{Binding IsEditingGroqKey}"
                                     BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}" Padding="0,0,28,0"
                                     FlowDirection="LeftToRight" Language="en-US"
                                     TextAlignment="Left" HorizontalContentAlignment="Left"/>
                        </Border>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="ToggleGroqKey_Click" ToolTip="Afficher / masquer la clé">
                            <TextBlock x:Name="EyeIconGroq" Text="🔓" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding StatutGroq}" Foreground="{Binding StatutGroqBrush}" FontSize="12" Margin="0,0,0,10"
                               Visibility="{Binding HasStatutGroq, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryBtn}" Width="160" Height="36" HorizontalAlignment="Left"
                                Command="{Binding TesterCleGroqCommand}" Content="Tester la connexion" Margin="0,0,10,0"/>
                        <Button Width="120" Height="36" HorizontalAlignment="Left" Margin="0,0,10,0"
                                Command="{Binding ModifierCleGroqCommand}" Content="Modifier">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingGroqKey}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource SettingsSaveBtn}" Width="140" HorizontalAlignment="Left" Margin="0,0,10,0"
                                Command="{Binding EnregistrerCleGroqCommand}" Content="Enregistrer"
                                Visibility="{Binding IsEditingGroqKey, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource SecondaryBtn}" Width="120" Height="36" HorizontalAlignment="Left"
                                Command="{Binding AnnulerCleGroqCommand}" Content="Annuler"
                                Visibility="{Binding IsEditingGroqKey, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ Apparence ════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18" Width="860" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource NavyBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Apparence" FontSize="16" FontWeight="700" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Thème de l'interface" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <!-- Thème Clair -->
                        <Border x:Name="ThemeClairBorder" Width="120" CornerRadius="10" Padding="14,12" Margin="0,0,12,0" Cursor="Hand" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThemeClair}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding AppliquerThemeClairCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Clair" FontSize="12" FontWeight="600" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Thème Sombre -->
                        <Border x:Name="ThemeSombreBorder" Width="120" CornerRadius="10" Padding="14,12" Cursor="Hand" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ThemeSombre}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding AppliquerThemeSombreCommand}"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Sombre" FontSize="12" FontWeight="600" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource NavyBrush}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ Sécurité ══════════════════════════════════════════════════════ -->
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18" Width="860" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource NavyBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Securité" FontSize="16" FontWeight="700" Foreground="{DynamicResource NavyBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock FontSize="12" Foreground="{DynamicResource LabelBrush}" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"
                               Text="Pour votre compte, utilisez un mot de passe unique (évitez celui de votre messagerie ou d'autres services)."/>

                    <StackPanel Orientation="Horizontal">
                        <Button HorizontalAlignment="Left" Width="300" FontSize="13"
                                Command="{Binding ToggleMotDePasseFormCommand}" Content="Changer le mot de passe">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AfficherFormulaireMotDePasse}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" FlowDirection="LeftToRight"
                                Visibility="{Binding AfficherFormulaireMotDePasse, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ancien mot de passe" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12" FlowDirection="LeftToRight">
                            <Border x:Name="OldPasswordMaskedBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6">
                                <PasswordBox x:Name="OldPasswordBox" PasswordChanged="OldPasswordBox_OnPasswordChanged"
                                             BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                             FlowDirection="LeftToRight" Language="en-US"
                                             HorizontalContentAlignment="Left"/>
                            </Border>
                            <Border x:Name="OldPasswordPlainBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6" Visibility="Collapsed">
                                <TextBox x:Name="OldPasswordTextBox" TextChanged="OldPasswordTextBox_OnTextChanged"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}" Padding="0,0,28,0"
                                         FlowDirection="LeftToRight" Language="en-US"
                                         TextAlignment="Left" HorizontalContentAlignment="Left"/>
                            </Border>
                            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="ToggleOldPassword_Click" ToolTip="Afficher / masquer le mot de passe">
                                <TextBlock x:Name="EyeIconOld" Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Nouveau mot de passe" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12" FlowDirection="LeftToRight">
                            <Border x:Name="NewPasswordMaskedBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6">
                                <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_OnPasswordChanged"
                                             BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                             FlowDirection="LeftToRight" Language="en-US"
                                             HorizontalContentAlignment="Left"/>
                            </Border>
                            <Border x:Name="NewPasswordPlainBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6" Visibility="Collapsed">
                                <TextBox x:Name="NewPasswordTextBox" TextChanged="NewPasswordTextBox_OnTextChanged"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}" Padding="0,0,28,0"
                                         FlowDirection="LeftToRight" Language="en-US"
                                         TextAlignment="Left" HorizontalContentAlignment="Left"/>
                            </Border>
                            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="ToggleNewPassword_Click" ToolTip="Afficher / masquer le mot de passe">
                                <TextBlock x:Name="EyeIconNew" Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Exigences du nouveau mot de passe" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,8,0,6"/>
                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleLengthGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleLengthBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins 8 caractères" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleUpperGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleUpperBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins une majuscule" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleDigitGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleDigitBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins un chiffre" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleSpecialGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleSpecialBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins un symbole parmi ! @ # $ % ^ &amp; * ( ) _ + - =" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                        Visibility="{Binding ShowPasswordConfirmRule, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PasswordConfirmRuleGlyph}" Width="18" FontSize="13" Foreground="{Binding PasswordConfirmRuleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Le mot de passe et la confirmation sont identiques" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Confirmer le nouveau mot de passe" FontSize="11" FontWeight="600" Foreground="{DynamicResource LabelBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14" FlowDirection="LeftToRight">
                            <Border x:Name="ConfirmPasswordMaskedBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6">
                                <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                                             BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}"
                                             FlowDirection="LeftToRight" Language="en-US"
                                             HorizontalContentAlignment="Left"/>
                            </Border>
                            <Border x:Name="ConfirmPasswordPlainBorder" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource InputBgBrush}" Padding="10,6" Visibility="Collapsed">
                                <TextBox x:Name="ConfirmPasswordTextBox" TextChanged="ConfirmPasswordTextBox_OnTextChanged"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{DynamicResource TextBrush}" Padding="0,0,28,0"
                                         FlowDirection="LeftToRight" Language="en-US"
                                         TextAlignment="Left" HorizontalContentAlignment="Left"/>
                            </Border>
                            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="ToggleConfirmPassword_Click" ToolTip="Afficher / masquer le mot de passe">
                                <TextBlock x:Name="EyeIconConfirm" Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource AccentBrush}"/>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryBtn}" Width="120" HorizontalAlignment="Left"
                                    Command="{Binding AnnulerMotDePasseFormCommand}" Content="Annuler" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SettingsSaveBtn}" Width="190" HorizontalAlignment="Left"
                                    Command="{Binding EnregistrerMotDePasseCommand}" Content="Changer mot de passe"
                                    Visibility="{Binding HasPasswordChanges, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding MessageSecurite}" Foreground="{Binding MessageSecuriteBrush}" FontSize="12" Margin="0,12,0,0"
                                   Visibility="{Binding HasMessageSecurite, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,18,0,14"/>

                    <Border BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,14" Background="{DynamicResource DangerZoneBgBrush}">
                        <StackPanel>
                            <TextBlock Text="Zone sensible" FontSize="12" FontWeight="700" Foreground="{DynamicResource DangerZoneTitleBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="La suppression définitive de votre compte retire l'accès à SmarTest et efface toutes vos données locales (cours, questions, quiz, examens)." FontSize="12" Foreground="{DynamicResource DangerZoneTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Style="{StaticResource SettingsDangerBtn}" Content="Supprimer mon compte" HorizontalAlignment="Left"
                                    Command="{Binding SupprimerCompteCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


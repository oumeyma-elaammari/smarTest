<UserControl x:Class="smartest_desktop.Views.SettingsAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FlowDirection="LeftToRight"
             Language="en-US">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <Style x:Key="SettingsSaveBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="9">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer FlowDirection="LeftToRight"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Padding="0,0,4,16">
        <StackPanel FlowDirection="LeftToRight">
            <TextBlock Text="Paramètres" FontSize="24" FontWeight="700" Foreground="#0f1e3d" Margin="0,0,0,18"/>
            <Border Background="White" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="12" Padding="20,18" Width="860" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0f1e3d" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Profil" FontSize="16" FontWeight="700" Foreground="#0f1e3d" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Nom complet" FontSize="11" FontWeight="600" Foreground="#64748b" Margin="0,0,0,6"/>
                    <Border BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6" Margin="0,0,0,12">
                        <TextBox Text="{Binding CompteNom, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0f1e3d"/>
                    </Border>

                    <TextBlock Text="Email" FontSize="11" FontWeight="600" Foreground="#64748b" Margin="0,0,0,6"/>
                    <Border BorderBrush="#fafbfd" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6" Margin="0,0,0,14">
                        <TextBlock Text="{Binding CompteEmail}" FontSize="13" Foreground="#0f1e3d" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SettingsSaveBtn}" Width="150" HorizontalAlignment="Left"
                                Command="{Binding EnregistrerCommand}" Content="Enregistrer"
                                Visibility="{Binding HasCompteChanges, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding MessageCompte}" Foreground="{Binding MessageCompteBrush}" FontSize="12" Margin="0,12,0,0"
                               Visibility="{Binding HasMessageCompte, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="12" Padding="20,18" Width="860" HorizontalAlignment="Left">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0f1e3d" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Securité" FontSize="16" FontWeight="700" Foreground="#0f1e3d" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock FontSize="12" Foreground="#64748b" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="18"
                               Text="Pour votre compte, utilisez un mot de passe unique (évitez celui de votre messagerie ou d'autres services)."/>

                    <StackPanel Orientation="Horizontal">     
                        <Button BorderBrush="#e2e8f4" BorderThickness="1"  Background="#fafbfd" Padding="10" HorizontalAlignment="Left" Width="300" FontSize="13"
                                Command="{Binding ToggleMotDePasseFormCommand}" Content="Changer le mot de passe">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AfficherFormulaireMotDePasse}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" FlowDirection="LeftToRight"
                                Visibility="{Binding AfficherFormulaireMotDePasse, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ancien mot de passe" FontSize="11" FontWeight="600" Foreground="#64748b" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12" FlowDirection="LeftToRight">
                            <Border x:Name="OldPasswordMaskedBorder" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6">
                                <PasswordBox x:Name="OldPasswordBox" PasswordChanged="OldPasswordBox_OnPasswordChanged"
                                             BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0f1e3d"
                                             FlowDirection="LeftToRight" Language="en-US"
                                             HorizontalContentAlignment="Left"/>
                            </Border>
                            <Border x:Name="OldPasswordPlainBorder" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6" Visibility="Collapsed">
                                <TextBox x:Name="OldPasswordTextBox" TextChanged="OldPasswordTextBox_OnTextChanged"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0f1e3d" Padding="0,0,28,0"
                                         FlowDirection="LeftToRight" Language="en-US"
                                         TextAlignment="Left" HorizontalContentAlignment="Left"/>
                            </Border>
                            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="ToggleOldPassword_Click" ToolTip="Afficher / masquer le mot de passe">
                                <TextBlock x:Name="EyeIconOld" Text="🔓" FontSize="15" Foreground="#0f1e3d"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Nouveau mot de passe" FontSize="11" FontWeight="600" Foreground="#64748b" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12" FlowDirection="LeftToRight">
                            <Border x:Name="NewPasswordMaskedBorder" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6">
                                <PasswordBox x:Name="NewPasswordBox" PasswordChanged="NewPasswordBox_OnPasswordChanged"
                                             BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0f1e3d"
                                             FlowDirection="LeftToRight" Language="en-US"
                                             HorizontalContentAlignment="Left"/>
                            </Border>
                            <Border x:Name="NewPasswordPlainBorder" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6" Visibility="Collapsed">
                                <TextBox x:Name="NewPasswordTextBox" TextChanged="NewPasswordTextBox_OnTextChanged"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0f1e3d" Padding="0,0,28,0"
                                         FlowDirection="LeftToRight" Language="en-US"
                                         TextAlignment="Left" HorizontalContentAlignment="Left"/>
                            </Border>
                            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="ToggleNewPassword_Click" ToolTip="Afficher / masquer le mot de passe">
                                <TextBlock x:Name="EyeIconNew" Text="🔓" FontSize="15" Foreground="#0f1e3d"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Exigences du nouveau mot de passe" FontSize="11" FontWeight="600" Foreground="#64748b" Margin="0,8,0,6"/>
                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleLengthGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleLengthBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins 8 caractères" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleUpperGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleUpperBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins une majuscule" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleDigitGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleDigitBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins un chiffre" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding PasswordRuleSpecialGlyph}" Width="22" FontSize="13" Foreground="{Binding PasswordRuleSpecialBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Au moins un symbole parmi ! @ # $ % ^ &amp; * ( ) _ + - =" FontSize="12" Foreground="#475569" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0"
                                        Visibility="{Binding ShowPasswordConfirmRule, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PasswordConfirmRuleGlyph}" Width="18" FontSize="13" Foreground="{Binding PasswordConfirmRuleBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Le mot de passe et la confirmation sont identiques" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Confirmer le nouveau mot de passe" FontSize="11" FontWeight="600" Foreground="#64748b" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14" FlowDirection="LeftToRight">
                            <Border x:Name="ConfirmPasswordMaskedBorder" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6">
                                <PasswordBox x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                                             BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0f1e3d"
                                             FlowDirection="LeftToRight" Language="en-US"
                                             HorizontalContentAlignment="Left"/>
                            </Border>
                            <Border x:Name="ConfirmPasswordPlainBorder" BorderBrush="#e2e8f4" BorderThickness="1" CornerRadius="8" Background="#fafbfd" Padding="10,6" Visibility="Collapsed">
                                <TextBox x:Name="ConfirmPasswordTextBox" TextChanged="ConfirmPasswordTextBox_OnTextChanged"
                                         BorderThickness="0" Background="Transparent" FontSize="13" Foreground="#0f1e3d" Padding="0,0,28,0"
                                         FlowDirection="LeftToRight" Language="en-US"
                                         TextAlignment="Left" HorizontalContentAlignment="Left"/>
                            </Border>
                            <Button Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="ToggleConfirmPassword_Click" ToolTip="Afficher / masquer le mot de passe">
                                <TextBlock x:Name="EyeIconConfirm" Text="🔓" FontSize="15" Foreground="#0f1e3d"/>
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryBtn}" Width="120" HorizontalAlignment="Left"
                                    Command="{Binding AnnulerMotDePasseFormCommand}" Content="Annuler" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SettingsSaveBtn}" Width="190" HorizontalAlignment="Left"
                                    Command="{Binding EnregistrerMotDePasseCommand}" Content="Changer mot de passe"
                                    Visibility="{Binding HasPasswordChanges, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding MessageSecurite}" Foreground="{Binding MessageSecuriteBrush}" FontSize="12" Margin="0,12,0,0"
                                   Visibility="{Binding HasMessageSecurite, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Border Height="1" Background="#eef2fb" Margin="0,18,0,14"/>

                    <Border BorderBrush="#fecaca" BorderThickness="1" CornerRadius="10" Padding="14,14" Background="#fef2f2">
                        <StackPanel>
                            <TextBlock Text="Zone sensible" FontSize="12" FontWeight="700" Foreground="#991b1b" Margin="0,0,0,6"/>
                            <TextBlock Text="La suppression définitive de votre compte retire l'accès à SmarTest pour cet utilisateur." FontSize="12" Foreground="#7f1d1d" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button Content="Supprimer mon compte" HorizontalAlignment="Left" Padding="14,8" Cursor="Hand"
                                    Command="{Binding SupprimerCompteCommand}"
                                    BorderBrush="#dc2626" BorderThickness="1" Background="White"
                                    Foreground="#dc2626" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

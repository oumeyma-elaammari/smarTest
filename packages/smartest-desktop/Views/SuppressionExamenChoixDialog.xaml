<Window x:Class="smartest_desktop.Views.SuppressionExamenChoixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supprimer l'examen"
        Icon="/Assets/SmarTest-AppIcon.png"
        Width="520"
        MinWidth="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24,20" BorderBrush="{DynamicResource CardBorderBrush}">
        <StackPanel>
            <TextBlock x:Name="TxtTitre" FontSize="17" FontWeight="700" Foreground="{DynamicResource NavyBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Choisissez le type de suppression :"
                       FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,16"/>
            <Button x:Name="BtnBureauSeul" HorizontalContentAlignment="Left" Padding="14,12" Margin="0,0,0,10"
                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Cursor="Hand"
                    Click="BtnBureauSeul_Click">
                <StackPanel>
                    <TextBlock Text="Supprimer du bureau uniquement" FontWeight="600" Foreground="{DynamicResource NavyBrush}"/>
                    <TextBlock x:Name="TxtBureauSeul" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource LabelBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnBureauEtWeb" HorizontalContentAlignment="Left" Padding="14,12" Margin="0,0,0,16"
                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Cursor="Hand"
                    Click="BtnBureauEtWeb_Click">
                <StackPanel>
                    <TextBlock Text="Supprimer du bureau et du web" FontWeight="600" Foreground="{DynamicResource NavyBrush}"/>
                    <TextBlock x:Name="TxtBureauEtWeb" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource LabelBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="TxtAvertissementWeb" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarnBrush}"
                       Margin="0,0,0,12" Visibility="Collapsed"/>
            <Button Content="Annuler" HorizontalAlignment="Right" Padding="14,8" IsCancel="True"
                    Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextTertiaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    FontWeight="600" Cursor="Hand" Click="BtnAnnuler_Click"/>
        </StackPanel>
    </Border>
</Window>


<Window x:Class="smartest_desktop.Views.QuizGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:smartest_desktop.ViewModels"
        Title="SmarTest — Générer un quiz"
        Icon="/Assets/SmarTest-AppIcon.png"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

	<Window.DataContext>
		<vm:QuizGenerationViewModel/>
	</Window.DataContext>

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/Views/Styles/StylesGlobal.xaml"/>
				<ResourceDictionary Source="/Views/Styles/GenerationSharedStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Background="{DynamicResource WindowBgBrush}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

		<!-- ══ HEADER ══ -->
		<Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" Padding="14,10" Margin="0,0,0,0">
			<Border.Effect>
				<DropShadowEffect BlurRadius="24" ShadowDepth="1" Direction="270"
								  Opacity="0.04" Color="#0f1e3d"/>
			</Border.Effect>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                        Background="{DynamicResource AccentLightBgBrush}" Cursor="Hand" Margin="0,0,8,0"
						BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
					<Border.InputBindings>
						<MouseBinding MouseAction="LeftClick" Command="{Binding AnnulerCommand}"/>
					</Border.InputBindings>
					<TextBlock Text="&#xE72B;" FontSize="15" FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource NavyBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>

				<StackPanel Grid.Column="1" VerticalAlignment="Center">
					<TextBlock Text="Nouveau quiz" FontSize="20" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
				</StackPanel>

			</Grid>
		</Border>

		<!-- ══ CONTENU — 2 colonnes ══ -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="380"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ══ COLONNE GAUCHE — Paramètres ══ -->
			<Border Grid.Column="0" Background="{DynamicResource WindowBgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="24,26,24,28">

						<TextBlock Text="Paramètres"
                                   FontSize="18" FontWeight="700" Foreground="{DynamicResource NavyBrush}" Margin="0,0,0,24"/>

						<!-- Titre du quiz -->
						<TextBlock Text="TITRE DU QUIZ" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,8"/>
						<Border Background="{DynamicResource InputBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" Padding="14,12" Margin="0,0,0,24">
							<TextBox Text="{Binding TitreQuiz, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="12" Foreground="{DynamicResource NavyBrush}"
                                     VerticalAlignment="Center" CaretBrush="{DynamicResource AccentBrush}"/>
						</Border>

						<!-- Nombre de questions -->
						<TextBlock Text="NOMBRE DE QUESTIONS" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,8"/>
						<ComboBox Style="{StaticResource StyledCombo}"
                                  ItemsSource="{Binding NombresQuestions}"
                                  SelectedItem="{Binding NombreQuestions}"
                                  Margin="0,0,0,24"/>

						<!-- Difficulté (sélection multiple) -->
						<TextBlock Text="NIVEAU DE DIFFICULTÉ" FontSize="10" FontWeight="700"
                                   Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4"/>
						<TextBlock Text="Combinez un ou plusieurs niveaux (clic pour activer / désactiver)."
                                   FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,28">
							<!-- Facile -->
							<Border CornerRadius="9" Padding="12,10" Cursor="Hand" Margin="0,0,8,0" Width="100">
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick" Command="{Binding SetDifficulteCommand}" CommandParameter="Facile"/>
								</Border.InputBindings>
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
										<Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
										<Setter Property="BorderThickness" Value="1.5"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsDifficulteFacileSelected}" Value="True">
												<Setter Property="Background" Value="{DynamicResource SuccessLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<StackPanel HorizontalAlignment="Center">
									<Ellipse Width="12" Height="12" Fill="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
									<TextBlock Text="Facile" FontSize="11" FontWeight="600"
                                               Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
								</StackPanel>
							</Border>

							<!-- Moyen -->
							<Border CornerRadius="9" Padding="12,10" Cursor="Hand" Margin="0,0,8,0" Width="100">
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick" Command="{Binding SetDifficulteCommand}" CommandParameter="Moyen"/>
								</Border.InputBindings>
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
										<Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
										<Setter Property="BorderThickness" Value="1.5"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsDifficulteMoyenSelected}" Value="True">
												<Setter Property="Background" Value="{DynamicResource WarnLightBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<StackPanel HorizontalAlignment="Center">
									<Ellipse Width="12" Height="12" Fill="{DynamicResource WarnBrush}" HorizontalAlignment="Center"/>
									<TextBlock Text="Moyen" FontSize="11" FontWeight="600"
                                               Foreground="{DynamicResource WarnBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
								</StackPanel>
							</Border>

							<!-- Difficile -->
							<Border CornerRadius="9" Padding="12,10" Cursor="Hand" Width="100">
								<Border.InputBindings>
									<MouseBinding MouseAction="LeftClick" Command="{Binding SetDifficulteCommand}" CommandParameter="Difficile"/>
								</Border.InputBindings>
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
										<Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
										<Setter Property="BorderThickness" Value="1.5"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsDifficulteDifficileSelected}" Value="True">
												<Setter Property="Background" Value="{DynamicResource DangerZoneBgBrush}"/>
												<Setter Property="BorderBrush" Value="{DynamicResource DangerZoneBorderBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<StackPanel HorizontalAlignment="Center">
									<Ellipse Width="12" Height="12" Fill="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
									<TextBlock Text="Difficile" FontSize="11" FontWeight="600"
                                               Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
								</StackPanel>
							</Border>
						</StackPanel>

						<!-- Statut -->
						<Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                                Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
							<TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
						</Border>

						<!-- Erreur -->
						<Border CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
                                Background="{DynamicResource AlertErrorBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
							<TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                       Foreground="{DynamicResource AlertErrorFgBrush}" TextWrapping="Wrap"/>
						</Border>

						<!-- Bouton Générer -->
						<Border CornerRadius="12" Padding="0,16" Cursor="Hand"
                                Visibility="{Binding IsNotGenerating, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding HasCours}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
                                            <Setter Property="Cursor" Value="Arrow"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding GenererCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Générer le quiz"
                                           FontSize="14" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

						<!-- Annuler génération -->
						<Border CornerRadius="12" Padding="0,16" Cursor="Hand"
                                Background="{DynamicResource DangerZoneBgBrush}" BorderBrush="{DynamicResource DangerZoneBorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding AnnulerGenerationCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Annuler la génération"
                                           FontSize="13" FontWeight="600" Foreground="{DynamicResource DangerBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

				
					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- ══ COLONNE DROITE — Import + aperçu cours ══ -->
			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- Header colonne droite (aligné création examen) -->
				<Border Grid.Row="0" Padding="28,22,28,18" Background="{DynamicResource WindowBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0" VerticalAlignment="Center">
							<TextBlock Text="Cours importé" FontSize="17" FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
							<TextBlock Text="Un seul fichier · texte modifiable ci-dessous."
                                       FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
						</StackPanel>

						<Border Grid.Column="1" CornerRadius="10" Cursor="Hand" Padding="16,10" VerticalAlignment="Center">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding ImporterFichierCommand}"/>
							</Border.InputBindings>
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
									<Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
									<Setter Property="BorderThickness" Value="1"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="{DynamicResource ActiveMenuBgBrush}"/>
											<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
										</Trigger>
										<DataTrigger Binding="{Binding IsImporting}" Value="True">
											<Setter Property="Background" Value="{DynamicResource SecondaryBtnBgBrush}"/>
											<Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<StackPanel Orientation="Horizontal">
						
								<TextBlock FontSize="12" FontWeight="700" Foreground="{DynamicResource AccentTextBrush}">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Text" Value="Importer un cours"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsImporting}" Value="True">
													<Setter Property="Text" Value="Import en cours..."/>
												</DataTrigger>
												<DataTrigger Binding="{Binding HasCours}" Value="True">
													<Setter Property="Text" Value="Changer de fichier"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</StackPanel>
						</Border>
					</Grid>
				</Border>

				<!-- Corps colonne droite -->
				<Grid Grid.Row="1" Background="{DynamicResource WindowBgBrush}">

					<!-- État vide -->
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasCours}" Value="False">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>

						<Border Width="320" Height="220" CornerRadius="16"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2"
                                Background="{DynamicResource CardBgBrush}" Cursor="Hand">
							<Border.InputBindings>
								<MouseBinding MouseAction="LeftClick" Command="{Binding ImporterFichierCommand}"/>
							</Border.InputBindings>
							<Border.Style>
								<Style TargetType="Border">
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
											<Setter Property="Background" Value="{DynamicResource AccentLightBgBrush}"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
								<TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="44"
										   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
								<TextBlock Text="Importer un cours"
                                           FontSize="14" FontWeight="600" Foreground="{DynamicResource NavyBrush}"
                                           HorizontalAlignment="Center"/>
								<TextBlock Text="PDF · DOCX · TXT"
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
							</StackPanel>
						</Border>

					</StackPanel>

					<!-- Cours importé -->
					<Grid>
						<Grid.Style>
							<Style TargetType="Grid">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding HasCours}" Value="True">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Grid.Style>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<!-- Fichier (pilule + corbeille, comme création examen) -->
						<Border Grid.Row="0" Margin="20,16,20,0" CornerRadius="12"
                                Background="{DynamicResource AccentLightBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,12">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid Grid.Row="0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Border Grid.Column="0" HorizontalAlignment="Left" MaxWidth="520"
                                            Padding="10,6" CornerRadius="8" Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding TitreCours}" FontWeight="600" FontSize="12"
                                                       Foreground="{DynamicResource NavyBrush}" TextTrimming="CharacterEllipsis"/>
											<Border CornerRadius="4" Padding="4,1" Margin="8,0,0,0"
                                                    Background="{DynamicResource AccentLightBgBrush}" VerticalAlignment="Center">
												<TextBlock Text="{Binding TypeFichier}" FontSize="10"
                                                           FontWeight="700" Foreground="{DynamicResource NavyBrush}"/>
											</Border>
										</StackPanel>
									</Border>
									<Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                            Background="{DynamicResource AlertErrorBgBrush}" Cursor="Hand" VerticalAlignment="Center"
                                            Margin="12,0,0,0">
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick" Command="{Binding EffacerContenuCommand}"/>
										</Border.InputBindings>
										<Border.Style>
											<Style TargetType="Border">
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="{DynamicResource DangerZoneBorderBrush}"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</Grid>
								<TextBlock Grid.Row="1" Text="{Binding NombreCaracteres}" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,8,0,0"/>
							</Grid>
						</Border>

						<!-- Texte extrait — toujours éditable -->
						<Border Grid.Row="1" Margin="20,12,20,20" CornerRadius="12"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>
								<Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1"
                                        Background="{DynamicResource InputBgBrush}">
									<TextBlock Text="Texte extrait (modifiable)"
                                               FontSize="11" FontWeight="600" Foreground="{DynamicResource SubTextBrush}"/>
								</Border>
								<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="14,12" MinHeight="240">
									<TextBox Text="{Binding ContenuCours, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Foreground="{DynamicResource AnswerFgBrush}"
                                             BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             CaretBrush="{DynamicResource AccentBrush}"/>
								</ScrollViewer>
							</Grid>
						</Border>
					</Grid>

				</Grid>
			</Grid>
		</Grid>

	</Grid>
</Window>


